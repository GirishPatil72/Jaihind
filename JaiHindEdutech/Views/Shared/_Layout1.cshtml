<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="Content-Language" content="en">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <title>@ViewBag.Title - Jai Hind Edutech</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, shrink-to-fit=no" />

    <!-- Disable tap highlight on IE -->
    <meta name="msapplication-tap-highlight" content="no">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/assets/css/base.css">
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css">
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>

    <style>
        :root {
            --app-bg: #f4f7fb;
            --app-surface: #ffffff;
            --app-surface-alt: #f8fafc;
            --app-border: #e5eaf1;
            --app-text: #1f2937;
            --app-muted: #6b7280;
            --app-primary: #1f4e79;
            --app-primary-hover: #163b5c;
            --app-accent: #02adee;
            --app-success: #15803d;
            --app-warning: #b45309;
            --app-danger: #b91c1c;
            --app-info: #0f766e;
            --app-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        }

        body {
            background: var(--app-bg);
            color: var(--app-text);
        }

        .app-header {
            background: linear-gradient(90deg, #1f4e79 0%, #163b5c 100%) !important;
        }

        .border-left-header {
            color: #ffffff;
        }

        .app-sidebar,
        .app-sidebar.sidebar-shadow,
        .app-sidebar .scrollbar-sidebar,
        .app-sidebar .app-sidebar__inner {
            background: #0b1220 !important;
        }

        .app-sidebar {
            border-right: 1px solid rgba(255, 255, 255, 0.06);
            box-shadow: 12px 0 28px rgba(15, 23, 42, 0.12);
        }

        .app-sidebar__inner {
            padding: .75rem 0;
        }

        .vertical-nav-menu {
            padding: .25rem 0 .75rem;
        }

            .vertical-nav-menu li {
                margin: 0;
            }

                .vertical-nav-menu li a,
                .vertical-nav-menu li a:visited {
                    display: flex;
                    align-items: center;
                    gap: .65rem;
                    min-height: 42px;
                    margin: .2rem .65rem;
                    padding: .75rem .9rem !important;
                    border-radius: 12px;
                    color: #f8fafc !important;
                    background: transparent !important;
                    text-decoration: none !important;
                    opacity: 1 !important;
                    font-weight: 600;
                    transition: background-color .15s ease, color .15s ease, transform .15s ease, box-shadow .15s ease;
                }

                    .vertical-nav-menu li a:hover,
                    .vertical-nav-menu li a:focus,
                    .vertical-nav-menu li a:active {
                        color: #ffffff !important;
                        background: linear-gradient(90deg, rgba(2, 173, 238, 0.22) 0%, rgba(31, 78, 121, 0.30) 100%) !important;
                        text-decoration: none !important;
                        outline: none !important;
                        transform: translateX(2px);
                        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
                    }

                .vertical-nav-menu li.mm-active > a,
                .vertical-nav-menu li.mm-active > a:visited,
                .vertical-nav-menu li.mm-active > a:focus,
                .vertical-nav-menu li.mm-active > a:active {
                    color: #ffffff !important;
                    background: linear-gradient(90deg, rgba(255, 122, 24, 0.22) 0%, rgba(220, 20, 60, 0.22) 100%) !important;
                    font-weight: 700;
                    box-shadow: inset 4px 0 0 #ff7a18;
                }

            .vertical-nav-menu .mm-collapse {
                padding-left: 0;
            }

                .vertical-nav-menu .mm-collapse li a,
                .vertical-nav-menu .mm-collapse li a:visited {
                    color: #e2e8f0 !important;
                    opacity: 1 !important;
                    font-size: .92rem;
                    margin-left: 1rem;
                }

                    .vertical-nav-menu .mm-collapse li a:hover,
                    .vertical-nav-menu .mm-collapse li a:focus,
                    .vertical-nav-menu .mm-collapse li a:active {
                        color: #ffffff !important;
                        background: rgba(255, 255, 255, 0.10) !important;
                        box-shadow: inset 4px 0 0 #02adee;
                    }

            .vertical-nav-menu li a i,
            .vertical-nav-menu li a .metismenu-icon,
            .vertical-nav-menu li a .metismenu-state-icon {
                color: inherit !important;
                opacity: 1 !important;
            }

        .card,
        .user-card {
            background: var(--app-surface);
            border: 1px solid var(--app-border);
            border-radius: 16px;
            box-shadow: var(--app-shadow);
        }

        .card-header {
            background: var(--app-surface-alt);
            border-bottom: 1px solid var(--app-border);
        }

        .form-label {
            color: var(--app-text);
            font-weight: 600;
        }

        .form-control,
        .form-select {
            border: 1px solid var(--app-border);
            border-radius: 12px;
            min-height: 46px;
            box-shadow: none !important;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--app-accent);
                box-shadow: 0 0 0 0.2rem rgba(2, 173, 238, 0.15) !important;
            }

        .btn-primary {
            background: var(--app-primary);
            border-color: var(--app-primary);
            border-radius: 12px;
            font-weight: 600;
        }

            .btn-primary:hover {
                background: var(--app-primary-hover);
                border-color: var(--app-primary-hover);
            }

        .btn-light {
            border-radius: 12px;
            background: #eef2f7;
            border-color: #e2e8f0;
        }

        .table {
            background: var(--app-surface);
            border-color: var(--app-border);
        }

            .table thead th {
                background: #eaf2f8;
                color: var(--app-primary);
                font-weight: 700;
                border-bottom: 1px solid var(--app-border);
            }

            .table tbody tr:hover {
                background: #f8fbff;
            }

            .table td,
            .table th {
                border-color: var(--app-border);
                vertical-align: middle;
            }

        .badge.bg-success {
            background: #16a34a !important;
        }

        .badge.bg-secondary {
            background: #64748b !important;
        }

        .badge.bg-warning {
            background: #d97706 !important;
        }

        .badge.bg-danger {
            background: #dc2626 !important;
        }

        .page-title-subheading,
        .text-muted,
        .form-hint {
            color: var(--app-muted) !important;
        }

        .oval-nav-item > .nav-link {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            padding: .7rem 1.15rem;
            min-height: 46px;
            border-radius: 999px;
            background: linear-gradient(135deg, #ff7a18 0%, #dc143c 100%);
            color: #ffffff !important;
            font-weight: 700;
            letter-spacing: .02em;
            box-shadow: 0 8px 18px rgba(220, 20, 60, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }

            .oval-nav-item > .nav-link .nav-link-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.18);
                color: #ffffff !important;
                font-size: .95rem;
                flex: 0 0 28px;
            }

            .oval-nav-item > .nav-link .fa-angle-down {
                font-size: .95rem;
                opacity: .95;
            }

            .oval-nav-item > .nav-link:hover,
            .oval-nav-item > .nav-link:focus {
                color: #ffffff !important;
                box-shadow: 0 10px 24px rgba(220, 20, 60, 0.32);
                transform: translateY(-1px);
            }

        .oval-nav-item .popover-custom-content {
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
            border: 1px solid #e5eaf1;
        }

        .oval-nav-item .dropdown-mega-menu {
            background: #ffffff;
        }

        .oval-nav-item .grid-menu {
            padding: .75rem;
        }

        .oval-nav-item .nav-item-header {
            font-weight: 700;
            color: #1f4e79;
            text-transform: uppercase;
            letter-spacing: .05em;
            font-size: .78rem;
            padding: .25rem .5rem .75rem;
            border-bottom: 1px solid #edf2f7;
            margin-bottom: .5rem;
        }

        .college-nav-item {
            margin-bottom: .45rem;
        }

            .college-nav-item .nav-link {
                display: flex;
                align-items: center;
                gap: .55rem;
                padding: .7rem .85rem;
                border-radius: 12px;
                color: #1f2937 !important;
                background: #f8fbff;
                border: 1px solid #e5eaf1;
                transition: all .15s ease;
                font-weight: 600;
            }

                .college-nav-item .nav-link::before {
                    content: "\f19d";
                    font-family: "Font Awesome 5 Free", "Font Awesome 6 Free", "FontAwesome";
                    font-weight: 900;
                    color: #02adee;
                    font-size: .85rem;
                }

                .college-nav-item .nav-link:hover {
                    background: #1f4e79;
                    color: #ffffff !important;
                    border-color: #1f4e79;
                    transform: translateX(2px);
                }

                    .college-nav-item .nav-link:hover::before {
                        color: #ffffff;
                    }

                .college-nav-item .nav-link.mm-active {
                    background: linear-gradient(135deg, #1f4e79 0%, #163b5c 100%);
                    color: #ffffff !important;
                    border-color: #163b5c;
                }

                    .college-nav-item .nav-link.mm-active::before {
                        color: #ffffff;
                    }

        .vertical-nav-menu li a {
            white-space: nowrap;
            overflow: hidden;
        }

            .vertical-nav-menu li a .menu-text {
                display: inline-block;
                line-height: 1.2;
                color: inherit !important;
            }

            .vertical-nav-menu li a .metismenu-icon {
                position: static !important;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 20px;
                min-width: 20px;
                flex: 0 0 20px;
                margin-right: .25rem !important;
                color: inherit !important;
            }

            .vertical-nav-menu li a .metismenu-state-icon {
                margin-left: auto;
                color: inherit !important;
            }

        .sidebar-active-link {
            color: #ffffff !important;
            background: linear-gradient(90deg, rgba(255, 122, 24, 0.22) 0%, rgba(220, 20, 60, 0.28) 100%) !important;
            font-weight: 700;
            box-shadow: inset 4px 0 0 #ff7a18;
        }

            .sidebar-active-link:hover,
            .sidebar-active-link:focus,
            .sidebar-active-link:active {
                color: #ffffff !important;
                background: linear-gradient(90deg, rgba(2, 173, 238, 0.22) 0%, rgba(31, 78, 121, 0.30) 100%) !important;
            }
    </style>
</head>
@using System.Security.Claims
@using System

@{
    var claimsPrincipal = User as ClaimsPrincipal;
    var fullNameClaim = claimsPrincipal != null ? claimsPrincipal.FindFirst("FullName") : null;
    var fullName = fullNameClaim != null ? fullNameClaim.Value : "";

    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();

    Func<string, string, string> sidebarLinkClass = (controller, action) =>
        "nav-link" +
        (string.Equals(currentController, controller, System.StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentAction, action, System.StringComparison.OrdinalIgnoreCase)
            ? " sidebar-active-link"
            : "");

    var isDashboardMenuActive =
        string.Equals(currentController, "Admission", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "FeeReceipts", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "Admin", System.StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "CoachingCentres", System.StringComparison.OrdinalIgnoreCase);
}
<body>
    <div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
        <!--Header START-->
        <div class="app-header header-shadow">
            <div class="app-header__logo">
                <a href="@Url.Action("Index", "Home")" title="Home" style="display:block; height:100%;">
                    <div class="logo-src"></div>
                </a>
                @*<div class="header__pane ml-auto">
                        <div>
                            <button type="button" class="hamburger close-sidebar-btn hamburger--elastic" data-class="closed-sidebar">
                                <span class="hamburger-box">
                                    <span class="hamburger-inner"></span>
                                </span>
                            </button>
                        </div>
                    </div>*@
            </div>
            <div class="app-header__mobile-menu">
                <div>
                    <button type="button" class="hamburger hamburger--elastic mobile-toggle-nav">
                        <span class="hamburger-box">
                            <span class="hamburger-inner"></span>
                        </span>
                    </button>
                </div>
            </div>
            <div class="app-header__menu">
                <span>
                    <button type="button" class="btn-icon btn-icon-only btn btn-primary btn-sm mobile-toggle-header-nav">
                        <span class="btn-icon-wrapper">
                            <i class="fa fa-ellipsis-v fa-w-6"></i>
                        </span>
                    </button>
                </span>
            </div>
            <div class="app-header__content">
                <div class="app-header-left">


                    <h2 class="border-left-header">STUDENT MANAGEMENT SYSTEM</h2>

                </div>
                <div class="app-header-right">

                    <ul class="header-megamenu nav" style="height:50px; border-left: 2px solid #02ADEE; border-right: 2px solid #02ADEE; ">
                        @if (Request.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item oval-nav-item">
                                <a href="javascript:void(0);"
                                   data-placement="bottom"
                                   rel="popover-focus"
                                   data-offset="300"
                                   data-toggle="popover-custom"
                                   class="nav-link">
                                    <i class="nav-link-icon fa fa-university"></i>
                                    <span>Admission Process</span>
                                    <i class="fa fa-angle-down ms-1"></i>
                                </a>
                                <div class="rm-max-width">
                                    <div class="d-none popover-custom-content">
                                        <div class="dropdown-mega-menu">
                                            <div class="grid-menu grid-menu-3col">
                                                <div class="no-gutters row">
                                                    @{ var collegeData = ViewBag.CollegeInfoSharedData as List<JaiHindEdutech.Entity.CollegeInfo>;
                                                        List<JaiHindEdutech.Entity.CollegeInfo> firstFive;
                                                        List<JaiHindEdutech.Entity.CollegeInfo> skipFiveNextFive;
                                                        if (collegeData != null)
                                                        {
                                                            firstFive = collegeData.Take(6).ToList();
                                                            skipFiveNextFive = collegeData.Skip(6).Take(6).ToList();
                                                        }
                                                        else
                                                        {
                                                            firstFive = new List<JaiHindEdutech.Entity.CollegeInfo>();
                                                            skipFiveNextFive = new List<JaiHindEdutech.Entity.CollegeInfo>();
                                                        }
                                                    }
                                                    <div class="col-sm-6 col-xl-6">
                                                        <ul class="nav flex-column">
                                                            <li class="nav-item-header nav-item">
                                                                Colleges
                                                            </li>
                                                            @foreach (var college in firstFive)
                                                            {
                                                                <li class="nav-item college-nav-item">
                                                                    @Html.ActionLink(college.CollegeName, "Index", "StudentInfoes", new { collegeId = college.CollegeInfoId, collegeName = college.CollegeName }, new { id = "college_" + college.CollegeInfoId, @class = "nav-link" })
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                    <div class="col-sm-6 col-xl-6" style="border-right-width:0px">
                                                        <ul class="nav flex-column">
                                                            <li class="nav-link"></li>
                                                            <li class="nav-link"></li>
                                                            @foreach (var college in skipFiveNextFive)
                                                            {
                                                                <li class="nav-item college-nav-item">
                                                                    @Html.ActionLink(college.CollegeName, "Index", "StudentInfoes", new { collegeId = college.CollegeInfoId, collegeName = college.CollegeName }, new { id = "college_" + college.CollegeInfoId, @class = "nav-link" })
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                        @if (Request.IsAuthenticated && User.IsInRole("Staff"))
                        {
                            var collegeData = ViewBag.CollegeInfoSharedData as List<JaiHindEdutech.Entity.CollegeInfo>;
                            List<JaiHindEdutech.Entity.CollegeInfo> firstFive;
                            List<JaiHindEdutech.Entity.CollegeInfo> skipFiveNextFive;
                            if (collegeData != null)
                            {
                                firstFive = collegeData.Take(6).ToList();
                                skipFiveNextFive = collegeData.Skip(6).Take(6).ToList();
                            }
                            else
                            {
                                firstFive = new List<JaiHindEdutech.Entity.CollegeInfo>();
                                skipFiveNextFive = new List<JaiHindEdutech.Entity.CollegeInfo>();
                            }

                            <li class="nav-item oval-nav-item">
                                <a href="javascript:void(0);" data-placement="bottom" rel="popover-focus" data-offset="300" data-toggle="popover-custom" class="nav-link" style="font-weight: 700; color: #DC143C">
                                    <i class="nav-link-icon fa fa-university"> </i> Admission Process
                                    <i class="fa fa-angle-down ml-2 opacity-5"></i>
                                </a>
                                <div class="rm-max-width">
                                    <div class="d-none popover-custom-content">
                                        <div class="dropdown-mega-menu">
                                            <div class="grid-menu grid-menu-3col">
                                                <div class="no-gutters row">

                                                    <div class="col-sm-6 col-xl-6">
                                                        <ul class="nav flex-column">
                                                            <li class="nav-item-header nav-item">
                                                                Colleges
                                                            </li>
                                                            @foreach (var college in firstFive)
                                                            {
                                                                <li class="nav-item college-nav-item">
                                                                    @Html.ActionLink(college.CollegeName, "Index", "Admission", new { collegeId = college.CollegeInfoId, collegeName = college.CollegeName }, new { id = "college_" + college.CollegeInfoId, @class = "nav-link" })
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                    <div class="col-sm-6 col-xl-6" style="border-right-width:0px">
                                                        <ul class="nav flex-column">
                                                            <li class="nav-link"></li>
                                                            <li class="nav-link"></li>
                                                            @foreach (var college in skipFiveNextFive)
                                                            {
                                                                <li class="nav-item college-nav-item">
                                                                    @Html.ActionLink(college.CollegeName, "Index", "Admission", new { collegeId = college.CollegeInfoId, collegeName = college.CollegeName }, new { id = "college_" + college.CollegeInfoId, @class = "nav-link" })
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                    <div class="header-btn-lg pr-0">
                        <div class="widget-content p-0">
                            <div class="widget-content-wrapper">
                                <div class="widget-content-left">
                                    <div class="btn-group">
                                        <a data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="p-0 btn">
                                            @*<img width="42" class="rounded-circle" src="../Content/assets/images/avatars/1.jpg" alt="">*@
                                            <i class="lnr-user icon-gradient bg-ripe-malin"> </i>
                                            <i class="fa fa-angle-down ml-2 opacity-8"></i>
                                        </a>
                                        <div tabindex="-1" role="menu" aria-hidden="true" class="rm-pointers dropdown-menu-lg dropdown-menu dropdown-menu-right">
                                            <div class="dropdown-menu-header">
                                                <div class="dropdown-menu-header-inner bg-info">
                                                    <div class="menu-header-image opacity-2" style="background-image: url('../Content/assets/images/dropdown-header/city3.jpg'); "></div>
                                                    <div class="menu-header-content text-left">
                                                        <div class="widget-content p-0">
                                                            <div class="widget-content-wrapper">
                                                                <div class="widget-content-left mr-3">
                                                                    @*<img width="42" class="rounded-circle" src="../Content/assets/images/avatars/1.jpg" alt="">*@
                                                                </div>
                                                                <div class="widget-content-left">
                                                                    <div class="widget-heading">
                                                                        @if (!string.IsNullOrWhiteSpace(fullName))
                                                                        {
                                                                            @fullName
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <div class="widget-content-right mr-2">
                                                                    <button onclick="location.href='@Url.Action("Logout", "Account")'" class="btn-pill btn-shadow btn-shine btn btn-focus">
                                                                        Logout
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="scroll-area-xs" style="height: 70px;">
                                                <div class="scrollbar-container ps">
                                                    <ul class="nav flex-column">

                                                        <li class="nav-item">
                                                            <a href="javascript:void(0);" class="nav-link">
                                                                Recover Password
                                                            </a>
                                                        </li>
                                                        <li class="nav-item-header nav-item">
                                                            My Account
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="widget-content-left  ml-3 header-user-info" style="color:#fff">
                                    <div class="widget-heading">
                                        @if (!string.IsNullOrWhiteSpace(fullName))
                                        {
                                            @fullName
                                        }
                                    </div>
                                    @*<div class="widget-subheading">
                                            VP People Manager
                                        </div>*@
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Header END-->
        <!--THEME OPTIONS START-->
        <div class="ui-theme-settings" style="display:none">
            <button type="button" id="TooltipDemo" class="btn-open-options btn btn-warning">
                <i class="fa fa-cog fa-w-16 fa-spin fa-2x"></i>
            </button>
            <div class="theme-settings__inner">
                <div class="scrollbar-container">
                    <div class="theme-settings__options-wrapper">
                        <h3 class="themeoptions-heading">
                            Layout Options
                        </h3>
                        <div class="p-3">
                            <ul class="list-group">
                                <li class="list-group-item">
                                    <div class="widget-content p-0">
                                        <div class="widget-content-wrapper">
                                            <div class="widget-content-left mr-3">
                                                <div class="switch has-switch switch-container-class" data-class="fixed-header">
                                                    <div class="switch-animate switch-on">
                                                        <input type="checkbox" checked data-toggle="toggle" data-onstyle="success">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="widget-content-left">
                                                <div class="widget-heading">
                                                    Fixed Header
                                                </div>
                                                <div class="widget-subheading">
                                                    Makes the header top fixed, always visible!
                                                </div>
                                            </div>
                                        </div>
