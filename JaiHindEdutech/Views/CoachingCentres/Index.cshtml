@model IEnumerable<JaiHindEdutech.Entity.CoachingCentre>

@{
    ViewBag.Title = "Index";
}
<p>
    @Html.ActionLink("Create New", "Create")
</p>

<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- DataTables JS -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>


<h2>All Academies</h2>


<table id="studentsTable" class="display" style="width:100%">
    <thead>
        <tr>
            <th>Coaching Centre Name</th>
            <th>Is Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var coaching in Model)
        {
            <tr>
                <td>@coaching.CoachingCentreName</td>
                <td>@coaching.IsActive</td>
                <td>

                    @Html.ActionLink("Edit", "Edit", new { id = coaching.CoachingCentreId }, new { @class = "btn btn-sm btn-primary" }) |
                    @Html.ActionLink("Details", "Details", new { id = coaching.CoachingCentreId }, new { @class = "btn btn-sm btn-primary" }) |
                    @*@Html.ActionLink("Delete", "Delete", new { id = coaching.CoachingCentreId }, new { @class = "btn btn-sm btn-primary" })*@

                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        $('#studentsTable').DataTable({
            paging: true,
            searching: true,
            ordering: true,
            info: true,
            columnDefs: [
                { targets: 0, width: "300px" }, // Name
                { targets: 1, width: "100px" }, // IsActive
                { targets: 2, width: "200px" }  // Actions
            ],
            autoWidth: false  // VERY important to prevent auto override
        });
    });
</script>
