@model IEnumerable<JaiHindEdutech.Entity.CoachingCentre>

@{
    ViewBag.Title = "Index";
    var totalCentres = Model!=null ?Model.Count() : 0;
}

<style>
    .page-shell {
        padding: 1.25rem .5rem;
    }

    .panel-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
        overflow: hidden;
        background: #fff;
        margin-bottom: 1rem;
    }

    .panel-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border-bottom: 1px solid #e5eaf1;
        padding: 1rem 1.25rem;
    }

    .header-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(2, 173, 238, 0.12);
        color: #02ADEE;
        flex: 0 0 46px;
    }

    .header-title {
        font-weight: 700;
        margin-bottom: 0;
        color: #0f172a;
    }

    .header-subtitle {
        color: #64748b;
        font-size: .95rem;
    }

    .section-label {
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #64748b;
        margin-bottom: .25rem;
    }

    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .45rem .8rem;
        border-radius: 999px;
        background: #eef6ff;
        color: #1f4e79;
        font-weight: 700;
        white-space: nowrap;
    }

    .toolbar-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .toolbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        border-radius: 12px;
        font-weight: 700;
    }

    .btn-primary {
        background: linear-gradient(135deg, #1f4e79 0%, #163b5c 100%);
        border-color: #1f4e79;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #163b5c 0%, #0f2d46 100%);
        border-color: #163b5c;
    }

    .btn-light {
        background: #eef2f7;
        border-color: #e2e8f0;
    }

    .table-wrap {
        padding: 0;
        overflow-x: auto;
    }

    table.dataTable {
        width: 100% !important;
        margin: 0 !important;
    }

    #coachingTable {
        width: 100% !important;
        table-layout: auto !important;
    }

    .table thead th {
        background: #eaf2f8 !important;
        color: #1f4e79;
        font-weight: 700;
        white-space: nowrap;
        border-bottom: 1px solid #dbe3ee !important;
    }

    .table tbody tr:hover {
        background: #f8fbff !important;
    }

    .table td,
    .table th {
        vertical-align: middle;
        border-color: #e5eaf1;
    }

    .badge-soft {
        border-radius: 999px;
        padding: .4rem .7rem;
        font-weight: 700;
        background: #eef6ff;
        color: #1f4e79;
        display: inline-block;
    }

    .action-group .btn {
        min-width: 90px;
        margin-right: .3rem;
        margin-bottom: .3rem;
    }

    .empty-state {
        padding: 2rem 1rem;
        text-align: center;
        color: #64748b;
    }

    .empty-state i {
        font-size: 2rem;
        color: #cbd5e1;
        margin-bottom: .5rem;
    }
</style>

<div class="container-fluid page-shell">

    <div class="panel-card">
        <div class="panel-header">
            <div class="toolbar-row">
                <div class="d-flex align-items-center">
                    <div class="header-icon d-inline-flex align-items-center justify-content-center me-3">
                        <i class="fa fa-building fa-lg"></i>
                    </div>
                    <div>
                        <div class="section-label">Coaching Centres</div>
                        <h4 class="header-title">All Academies</h4>
                        <div class="header-subtitle">Manage centre records, view details, and update information.</div>
                    </div>
                </div>

                <div class="toolbar-actions">
                    <span class="stat-pill">
                        <i class="fa fa-graduation-cap"></i>
                        @totalCentres Centres
                    </span>

                    @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary px-4" })
                </div>
            </div>
        </div>

        <div class="panel-body table-wrap">
            <div class="table-responsive">
                <table id="coachingTable" class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Coaching Centre Name</th>
                            <th>Is Active</th>
                            <th style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var coaching in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@coaching.CoachingCentreName</div>
                                    </td>
                                    <td>
                                        @if (coaching.IsActive == true)
                                        {
                                            <span class="badge-soft">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-group d-flex flex-wrap">
                                            @Html.ActionLink("Edit", "Edit", new { id = coaching.CoachingCentreId }, new { @class = "btn btn-sm btn-primary" })
                                            @Html.ActionLink("Details", "Details", new { id = coaching.CoachingCentreId }, new { @class = "btn btn-sm btn-outline-primary" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3">
                                    <div class="empty-state">
                                        <i class="fa fa-inbox"></i>
                                        <div class="fw-semibold">No coaching centres found.</div>
                                        <div class="text-muted">Create a new centre to get started.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#coachingTable').DataTable({
            paging: true,
            searching: true,
            ordering: true,
            info: true,
            pageLength: 10,
            autoWidth: false,
            columnDefs: [
                { targets: 0, width: "45%" },
                { targets: 1, width: "15%" },
                { targets: 2, width: "220px", orderable: false, searchable: false }
            ]
        });
    });
</script>
