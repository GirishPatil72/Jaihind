@model IEnumerable<JaiHindEdutech.Entity.FeeReceipt>
@using System.Linq

@{
    ViewBag.Title = "Fee Receipts";
    Layout = "~/Views/Shared/_Layout1.cshtml";
    var records = Model!=null?Model.ToList() : new List<JaiHindEdutech.Entity.FeeReceipt>();
}

<style>
    .grid-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .grid-card-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
    }

    .icon-badge {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(2, 173, 238, 0.12);
        color: #02ADEE;
    }

    .table thead th {
        background: #eaf2f8;
        color: #1f4e79;
        font-weight: 700;
        white-space: nowrap;
    }

    .table tbody tr:hover {
        background: #f8fbff;
    }

    .receipt-badge {
        border-radius: 999px;
        padding: .45rem .75rem;
        font-weight: 600;
    }
</style>

<div class="container-fluid py-4">
    <div class="card grid-card">
        <div class="card-header grid-card-header py-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <div class="icon-badge d-inline-flex align-items-center justify-content-center me-3">
                        <i class="fa fa-receipt fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-semibold">Fee Receipts</h4>
                        <div class="text-muted">Manage fee receipt records and payment details.</div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="fw-semibold">@records.Count() Records</div>
                    <div class="text-muted small">Active fee receipt list</div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.AdmissionFormId)</th>
                            <th>@Html.DisplayNameFor(model => model.AdmissionFee)</th>
                            <th>@Html.DisplayNameFor(model => model.ExamFee)</th>
                            <th>@Html.DisplayNameFor(model => model.Misclellaneous)</th>
                            <th>@Html.DisplayNameFor(model => model.C1StInstallment)</th>
                            <th>@Html.DisplayNameFor(model => model.C2ndInstallment)</th>
                            <th>@Html.DisplayNameFor(model => model.C3rdInstallment)</th>
                            <th>@Html.DisplayNameFor(model => model.C4thInstallment)</th>
                            <th>@Html.DisplayNameFor(model => model.BalanceAmount)</th>
                            <th>@Html.DisplayNameFor(model => model.TotalAmount)</th>
                            <th>@Html.DisplayNameFor(model => model.IsDeleted)</th>
                            <th>@Html.DisplayNameFor(model => model.CreatedBy)</th>
                            <th>@Html.DisplayNameFor(model => model.CreatedOn)</th>
                            <th>@Html.DisplayNameFor(model => model.ModifiedBy)</th>
                            <th>@Html.DisplayNameFor(model => model.ModifiedOn)</th>
                            <th style="width:140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (records.Any())
                        {
                            foreach (var item in records)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.AdmissionFormId)</td>
                                    <td>@Html.DisplayFor(modelItem => item.AdmissionFee)</td>
                                    <td>@Html.DisplayFor(modelItem => item.ExamFee)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Misclellaneous)</td>
                                    <td>@Html.DisplayFor(modelItem => item.C1StInstallment)</td>
                                    <td>@Html.DisplayFor(modelItem => item.C2ndInstallment)</td>
                                    <td>@Html.DisplayFor(modelItem => item.C3rdInstallment)</td>
                                    <td>@Html.DisplayFor(modelItem => item.C4thInstallment)</td>
                                    <td>@Html.DisplayFor(modelItem => item.BalanceAmount)</td>
                                    <td>@Html.DisplayFor(modelItem => item.TotalAmount)</td>
                                    <td>
                                        @if (item.IsDeleted == true)
                                        {
                                            <span class="badge bg-danger receipt-badge">Deleted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success receipt-badge">Active</span>
                                        }
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                                    <td>@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                                    <td>@Html.DisplayFor(modelItem => item.ModifiedBy)</td>
                                    <td>@Html.DisplayFor(modelItem => item.ModifiedOn)</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.FeeReceiptId }, new { @class = "btn btn-sm btn-warning" })
                                            @Html.ActionLink("Details", "Details", new { id = item.FeeReceiptId }, new { @class = "btn btn-sm btn-info text-white" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="16" class="text-center text-muted py-4">
                                    No fee receipt records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
