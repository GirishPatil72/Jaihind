@model JaiHindEdutech.Models.FeeReceiptModel
@using System.Linq

@{
    ViewBag.Title = "Create Fee Receipt";
    Layout = "~/Views/Shared/_Layout1.cshtml";
    var existingReceipts = Model.FeeReceipts ?? new List<JaiHindEdutech.Entity.FeeReceipt>();
}

<style>
    .fee-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .fee-card-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
    }

    .icon-badge {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(2, 173, 238, 0.12);
        color: #02ADEE;
    }

    .section-label {
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #6c757d;
        margin-bottom: .5rem;
    }

    .form-hint {
        font-size: .85rem;
        color: #6c757d;
    }

    .student-summary {
        background: #f8fbff;
        border: 1px solid #e5eaf1;
        border-radius: 14px;
        padding: 1rem 1.25rem;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin-bottom: .5rem;
        color: #334155;
        font-weight: 600;
    }

    .summary-item i {
        color: #02ADEE;
        width: 18px;
        text-align: center;
    }

    .table thead th {
        background: #eaf2f8;
        color: #1f4e79;
        font-weight: 700;
        white-space: nowrap;
    }

    .table tbody tr:hover {
        background: #f8fbff;
    }

    .receipt-actions .btn {
        min-width: 90px;
        border-radius: 10px;
    }
</style>

<div class="container-fluid py-4">
    <div class="card fee-card mb-4">
        <div class="card-header fee-card-header py-3">
            <div class="d-flex align-items-center">
                <div class="icon-badge d-inline-flex align-items-center justify-content-center me-3">
                    <i class="fa fa-file-invoice-dollar fa-lg"></i>
                </div>
                <div>
                    <h4 class="mb-0 fw-semibold">Create Fee Receipt</h4>
                    <div class="text-muted">Enter fee details and generate the receipt for this student.</div>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-lg-5">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.AdmissionFormId)
                @Html.HiddenFor(model => model.CreatedBy)
                @Html.HiddenFor(model => model.CreatedOn)
                @Html.HiddenFor(model => model.ModifiedBy)
                @Html.HiddenFor(model => model.ModifiedOn)
                @Html.HiddenFor(model => model.IsDeleted)

                <div class="row g-4">
                    <div class="col-12">
                        <div class="section-label">Student Information</div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="student-summary h-60">
                            <div class="summary-item">
                                <i class="fa fa-user"></i>
                                <span>@Model.FullName</span>
                            </div>
                            <div class="summary-item">
                                <i class="fa fa-graduation-cap"></i>
                                <span>@Model.ClassName @Model.Stream</span>
                            </div>
                            <div class="summary-item mb-0">
                                <i class="fa fa-school"></i>
                                <span>@Model.CollegeName</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-8 col-md-6">
                        <div class="alert alert-info border-0 h-60 mb-0">
                            <div class="fw-semibold mb-2">
                                <i class="fa fa-info-circle me-1"></i> Fee Entry Notes
                            </div>
                            <div class="small">
                                Admission fee, exam fee, and miscellaneous charges are used to calculate the total amount automatically.
                                The remaining amount is split into the second and third installments after the first installment is entered.
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="section-label">Fee Details</div>
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.AdmissionFee, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(model => model.AdmissionFee, new { @class = "form-control form-control-lg", type = "number", @id = "AdmissionFee", placeholder = "Enter admission fee" })
                        @Html.ValidationMessageFor(model => model.AdmissionFee, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.ExamFee, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(model => model.ExamFee, new { @class = "form-control form-control-lg", type = "number", @id = "ExamFee", placeholder = "Enter exam fee" })
                        @Html.ValidationMessageFor(model => model.ExamFee, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.Misclellaneous, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(model => model.Misclellaneous, new { @class = "form-control form-control-lg", type = "number", @id = "Misclellaneous", placeholder = "Enter miscellaneous" })
                        @Html.ValidationMessageFor(model => model.Misclellaneous, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.TotalAmount, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(model => model.TotalAmount, new { @class = "form-control form-control-lg bg-light", type = "number", @id = "TotalAmount", @readonly = true })
                        @Html.ValidationMessageFor(model => model.TotalAmount, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.C1StInstallment, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(model => model.C1StInstallment, new { @class = "form-control form-control-lg", type = "number", @id = "C1StInstallment", placeholder = "Enter 1st installment" })
                        @Html.ValidationMessageFor(model => model.C1StInstallment, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.BalanceAmount, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(model => model.BalanceAmount, new { @class = "form-control form-control-lg bg-light", type = "number", @id = "BalanceAmount", @readonly = true })
                        @Html.ValidationMessageFor(model => model.BalanceAmount, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.C2ndInstallment, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(model => model.C2ndInstallment, new { @class = "form-control form-control-lg bg-light", type = "number", @id = "C2ndInstallment", @readonly = true })
                        @Html.ValidationMessageFor(model => model.C2ndInstallment, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(model => model.C3rdInstallment, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(model => model.C3rdInstallment, new { @class = "form-control form-control-lg bg-light", type = "number", @id = "C3rdInstallment", @readonly = true })
                        @Html.ValidationMessageFor(model => model.C3rdInstallment, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 pt-2">
                        <div class="d-flex gap-2 justify-content-end">
                            @Html.ActionLink("Back to List", "GetAllStudents", "Admission", null, new { @class = "btn btn-light btn-lg px-4" })
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="fa fa-save me-2"></i> Create Receipt
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card fee-card">
        <div class="card-header fee-card-header py-3">
            <div class="d-flex align-items-center">
                <div class="icon-badge d-inline-flex align-items-center justify-content-center me-3">
                    <i class="fa fa-history fa-lg"></i>
                </div>
                <div>
                    <h4 class="mb-0 fw-semibold">Previous Fee Receipts</h4>
                    <div class="text-muted">Recent receipts already generated for this admission form.</div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Admission Fee</th>
                            <th>1st Installment</th>
                            <th>2nd Installment</th>
                            <th>3rd Installment</th>
                            <th>Exam Fee</th>
                            <th>Miscellaneous</th>
                            <th>Total Amount</th>
                            <th>Balance Amount</th>
                            <th style="width:120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (existingReceipts.Any())
                        {
                            foreach (var item in existingReceipts)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.AdmissionFee)</td>
                                    <td>@Html.DisplayFor(modelItem => item.C1StInstallment)</td>
                                    <td>@Html.DisplayFor(modelItem => item.C2ndInstallment)</td>
                                    <td>@Html.DisplayFor(modelItem => item.C3rdInstallment)</td>
                                    <td>@Html.DisplayFor(modelItem => item.ExamFee)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Misclellaneous)</td>
                                    <td>@Html.DisplayFor(modelItem => item.TotalAmount)</td>
                                    <td>@Html.DisplayFor(modelItem => item.BalanceAmount)</td>
                                    <td class="receipt-actions">
                                        @Html.ActionLink("Print", "FeeReceiptPDF", "FeeReceipts", new { AdmissionFormId = item.AdmissionFormId }, new { @class = "btn btn-sm btn-primary" })
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    No previous fee receipts found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#AdmissionFee, #ExamFee, #Misclellaneous, #C1StInstallment, #C2ndInstallment, #C3rdInstallment").on("input", function () {
            FeeCalculate();
        });

        FeeCalculate();
    });

    function FeeCalculate() {
        var admissionFee = parseFloat($("#AdmissionFee").val()) || 0;
        var examFee = parseFloat($("#ExamFee").val()) || 0;
        var miscellaneous = parseFloat($("#Misclellaneous").val()) || 0;
        var totalAmount = admissionFee + examFee + miscellaneous;

        $("#TotalAmount").val(totalAmount.toFixed(2));

        var firstInstallment = parseFloat($("#C1StInstallment").val()) || 0;

        if (firstInstallment > 0) {
            var balanceAmount = totalAmount - firstInstallment;
            var secondInstallment = balanceAmount / 2;
            var thirdInstallment = balanceAmount / 2;

            $("#C2ndInstallment").val(secondInstallment.toFixed(2));
            $("#C3rdInstallment").val(thirdInstallment.toFixed(2));
            $("#BalanceAmount").val(balanceAmount.toFixed(2));
        } else {
            $("#C2ndInstallment").val("");
            $("#C3rdInstallment").val("");
            $("#BalanceAmount").val(totalAmount.toFixed(2));
        }
    }
</script>
