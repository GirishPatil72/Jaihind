            </td>
            <td>
                @Html.DisplayFor(modelItem => item.C1StInstallment)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.C2ndInstallment)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.C3rdInstallment)
            </td>
            @*<td>
                    @Html.DisplayFor(modelItem => item.C4thInstallment)
                </td>*@
            <td>
                @Html.DisplayFor(modelItem => item.ExamFee)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Misclellaneous)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BalanceAmount)
            </td>
            <td>@Html.ActionLink("Print", "FeeReceiptPDF", "FeeReceipts", new { AdmissionFormId = item.AdmissionFormId }, new { @class = "btn btn-sm btn-primary" })</td>
            @*<td>
                    @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
                </td>*@
        </tr>
    }

</table>

<script type="text/javascript">
    $(document).ready(function () {
        $("#AdmissionFee, #ExamFee, #Misclellaneous, #C1StInstallment, #C2ndInstallment, #C3rdInstallment").on("input", function () {
            //myJsFunction(this.value);
            FeeCalculate();
        });
        //$("#ExamFee").on("change", function () {
        //    FeeCalculate();
        //});
        //$("#Misclellaneous").on("change", function () {
        //    FeeCalculate();
        //});
        ////$("#TotalAmount").on("change", function () {
        ////});
        //$("#C1StInstallment").on("change", function () {
        //    FeeCalculate();
        //});
        //$("#C2ndInstallment").on("change", function () {
        //    FeeCalculate();
        //});
        //$("#C3rdInstallment").on("change", function () {
        //    FeeCalculate();
        //});
    });

    function FeeCalculate() {
        debugger
        var AdmissionFee = parseFloat($("#AdmissionFee").val()) || 0;
        var ExamFee = parseFloat($("#ExamFee").val()) || 0;
        var Misclellaneous = parseFloat($("#Misclellaneous").val()) || 0;
        var TotalAmount = AdmissionFee + ExamFee + Misclellaneous;
        $("#TotalAmount").val(TotalAmount);

        var C1StInstallment = parseFloat($("#C1StInstallment").val()) || 0;

        if (C1StInstallment != 0) {
            var BalanceAmount = TotalAmount - C1StInstallment;
            var C2ndInstallment = BalanceAmount / 2;
            var C3rdInstallment = BalanceAmount / 2;
            $("#C2ndInstallment").val(C2ndInstallment);
            $("#C3rdInstallment").val(C3rdInstallment);
            $("#BalanceAmount").val(BalanceAmount);
        }
        else {
            $("#BalanceAmount").val(TotalAmount);
        }
    }
</script>
