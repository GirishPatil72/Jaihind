<br />
<br />

<div>
    @Html.ActionLink("Back to List", "GetAllStudents", "Admission")
</div>


<table class="table">
    <tr>
        <th>
            Admission Fee
        </th>
        <th>
            1St Installment
        </th>
        <th>
            2nd Installment
        </th>
        <th>
            3rd Installment
        </th>
        @*<th>
                4th Installment
            </th>*@
        <th>
            Exam Fee
        </th>
        <th>
