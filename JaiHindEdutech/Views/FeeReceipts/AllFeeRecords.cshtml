@model IEnumerable<JaiHindEdutech.Models.FeeData>
@using System.Linq

@{
    ViewBag.Title = "All Fee Records";
    Layout = "~/Views/Shared/_Layout1.cshtml";
    var records = Model!=null?Model.ToList() : new List<JaiHindEdutech.Models.FeeData>();
}

<style>
    .grid-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .grid-card-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
    }

    .icon-badge {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(2, 173, 238, 0.12);
        color: #02ADEE;
    }

    .table thead th {
        background: #eaf2f8;
        color: #1f4e79;
        font-weight: 700;
        white-space: nowrap;
    }

    .table tbody tr:hover {
        background: #f8fbff;
    }

    .receipt-actions .btn {
        min-width: 90px;
        border-radius: 10px;
    }

    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select {
        border-radius: 10px;
        border: 1px solid #dbe3ee;
        padding: 6px 10px;
        outline: none;
    }
</style>

<div class="container-fluid py-4">
    <div class="card grid-card">
        <div class="card-header grid-card-header py-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <div class="icon-badge d-inline-flex align-items-center justify-content-center me-3">
                        <i class="fa fa-rupee-sign fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-semibold">Fee Receipt Records</h4>
                        <div class="text-muted">View and manage student fee receipt entries.</div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="fw-semibold">@records.Count() Records</div>
                    <div class="text-muted small">All fee receipt transactions</div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="feeReceiptsTable" class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Roll Number</th>
                            <th>Class Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (records.Any())
                        {
                            foreach (var item in records)
                            {
                                <tr>
                                    <td>@item.FullName</td>
                                    <td>@item.RollNumber</td>
                                    <td>@item.ClassName</td>
                                    <td class="receipt-actions">
                                        <div class="d-flex flex-wrap gap-2">
                                            @Html.ActionLink("Print", "FeeReceiptPDF", "FeeReceipts", new { AdmissionFormId = item.AdmissionFormId }, new { @class = "btn btn-sm btn-primary", target = "_blank" })
                                            @Html.ActionLink("Fee Receipt", "Create", "FeeReceipts", new { AdmissionFormId = item.AdmissionFormId }, new { @class = "btn btn-sm btn-outline-primary" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No fee receipt records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    $(function () {
        $('#feeReceiptsTable').DataTable({
            paging: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            autoWidth: false,
            pageLength: 10,
            columnDefs: [
                { targets: 0, width: "150px" }, // Full Name
                { targets: 1, width: "100px" }, // Roll No
                { targets: 2, width: "180px" }, // Class
                { targets: 6, width: "120px" }  // Actions
            ]
        });
    });
</script>
