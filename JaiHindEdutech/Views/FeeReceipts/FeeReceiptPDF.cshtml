@model JaiHindEdutech.Models.FeeReceiptModel
@{
    Layout = null;
    var receipt = Model.FeeReceipts != null && Model.FeeReceipts.Any() ? Model.FeeReceipts.FirstOrDefault() : null;
    var formattedDate = receipt != null && receipt.ModifiedOn.HasValue
        ? receipt.ModifiedOn.Value.ToString("dd/MM/yyyy")
        : "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Fee Receipt</title>
    <style>
        @@page {
            size: A4;
            margin: 12mm;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            a[href]::after {
                content: "" !important;
            }

            body {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .receipt-container,
            table,
            tr,
            td,
            th {
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 13px;
            line-height: 1.4;
            margin: 0;
            padding: 0;
        }

        .no-print {
            text-align: right;
            margin: 10px 0 15px 0;
        }

        .receipt-container {
            border: 1px solid #000;
            padding: 15px;
            width: 100%;
            box-sizing: border-box;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        table, th, td {
            border: 1px solid #000;
        }

        th, td {
            padding: 8px;
            text-align: center;
            vertical-align: top;
        }

        .footer-table th, .footer-table td {
            padding: 6px;
        }

        .declaration {
            margin-top: 20px;
            font-style: italic;
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" class="btn btn-primary" onclick="window.print();">Print</button>
    </div>

    <div class="receipt-container">
        <table style="width: 100%; border: none;">
            <tr>
                <td style="width: 100px; vertical-align: middle; border: none;">
                    @if (!string.IsNullOrEmpty(Model.CollegeLogo))
                    {
                        <img src="@Model.CollegeLogo" alt="College Logo" style="width: 100px; height: 80px; object-fit: contain;" />
                    }
                </td>
                <td style="text-align: center; border: none;">
                    <h2 style="margin: 0;">@Model.CollegeName</h2>
                    @if (!string.IsNullOrEmpty(Model.CollegeAddress1))
                    {
                        <h4 style="margin: 4px 0;">@Model.CollegeAddress1, @Model.CollegeAddress2, @Model.CollegeCity</h4>
                    }
                    @if (!string.IsNullOrEmpty(Model.CollegeContact))
                    {
                        <h4 style="margin: 4px 0;">Ph. @Model.CollegeContact</h4>
                    }
                    <strong>@Model.CollegeType</strong>
                </td>
            </tr>
        </table>

        <table style="width: 100%; margin-top: 20px; font-size: 14px; border: none;">
            <tr>
                <td style="text-align: left; width: 50%; border: none;">
                    Received from <strong>@Model.FullName</strong><br />
                    Std. @Model.ClassName @Model.Stream
                </td>
                <td style="text-align: right; width: 50%; border: none;">
                    Receipt No. @(receipt != null ? receipt.FeeReceiptId.ToString() : "")<br />
                    Date: @formattedDate
                </td>
            </tr>
        </table>

        <table>
            <tr>
                <th>Sl. No.</th>
                <th>DESCRIPTION</th>
                <th>Amount</th>
            </tr>
            <tr><td>1.</td><td>Admission Fee</td><td>@(receipt != null ? receipt.AdmissionFee : null)</td></tr>
            <tr><td>2.</td><td>1<sup>st</sup> Installment</td><td>@(receipt != null ? receipt.C1StInstallment : null)</td></tr>
            <tr><td>3.</td><td>2<sup>nd</sup> Installment</td><td>@(receipt != null ? receipt.C2ndInstallment : null)</td></tr>
            <tr><td>4.</td><td>3<sup>rd</sup> Installment</td><td>@(receipt != null ? receipt.C3rdInstallment : null)</td></tr>
            <tr><td>5.</td><td>Exam Fee</td><td>@(receipt != null ? receipt.ExamFee : null)</td></tr>
            <tr><td>6.</td><td>Miscellaneous</td><td>@(receipt != null ? receipt.Misclellaneous : null)</td></tr>
        </table>

        <table class="footer-table">
            <tr>
                <th>Total Fees</th>
                <th>1<sup>st</sup> Installment</th>
                <th>2<sup>nd</sup> Installment</th>
                <th>3<sup>rd</sup> Installment</th>
                <th>Balance Fee</th>
            </tr>
            <tr>
                <td>@(receipt != null ? receipt.TotalAmount : null)</td>
                <td>@(receipt != null ? receipt.C1StInstallment : null)</td>
                <td>@(receipt != null ? receipt.C2ndInstallment : null)</td>
                <td>@(receipt != null ? receipt.C3rdInstallment : null)</td>
                <td>@(receipt != null ? receipt.BalanceAmount : null)</td>
            </tr>
        </table>

        <p class="declaration">
            Declaration: I understand and agrees that the fees I have paid to the college, will not refund back,
            If the admission got cancelled or transferred by me during the academic year.
        </p>

        <table style="width: 100%; margin-top: 20px; font-size: 14px; border: none;">
            <tr>
                <td style="text-align: left; width: 50%; border: none;">
                    <strong>Student/Parent’s Sign.</strong>
                </td>
                <td style="text-align: right; width: 50%; border: none;">
                    <strong>Admin. Signature</strong>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
