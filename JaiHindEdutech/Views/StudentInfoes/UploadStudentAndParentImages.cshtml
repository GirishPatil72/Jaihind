@model int
@using (Ajax.BeginForm("UploadImages", "StudentInfoes", null, new AjaxOptions { HttpMethod = "POST", InsertionMode = InsertionMode.Replace, OnSuccess = "ajaxSuccessUploadInfo(data)", OnBegin = "onUploadBegin", UpdateTargetId = "wizardContainer" }, new { enctype = "multipart/form-data", id = "frmuploadImages", name = "frmuploadImages", @class = "col-md-10 mx-auto" }))
{
    @Html.Hidden("studentInfoId", new { Value = Model })
    <div class="form-group">
        <label>Student Photo</label>
        <input type="file" name="StudentPhoto" id="StudentPhoto" accept="image/*" class="form-control" onchange="previewImage(this, 'studentPhotoPreview')" />
        <span class="text-danger" id="StudentPhotoError"></span>
        <img id="studentPhotoPreview" src="@ViewBag.StudentPhoto" alt="Student Photo Preview" style="@(string.IsNullOrEmpty(ViewBag.StudentPhoto) ? "display: none;" : "display: block;") max-width: 150px; max-height: 150px; margin-top: 10px;" />
    </div>

    <div class="form-group">
        <label>Student Signature</label>
        <input type="file" name="StudentSignature" id="StudentSignature" accept="image/*" class="form-control" onchange="previewImage(this, 'studentSignaturePreview')" />
        <span class="text-danger" id="StudentSignatureError"></span>
        <img id="studentSignaturePreview" src="@ViewBag.StudentSignature" alt="Student Signature Preview" style="@(string.IsNullOrEmpty(ViewBag.StudentSignature) ? "display: none;" : "display: block;") max-width: 150px; max-height: 150px; margin-top: 10px; " />
    </div>

    <div class="form-group">
        <label>Father Photo</label>
        <input type="file" name="FatherPhoto" id="FatherPhoto" accept="image/*" class="form-control" onchange="previewImage(this, 'fatherPhotoPreview')" />
        <span class="text-danger" id="FatherPhotoError"></span>
        <img id="fatherPhotoPreview" src="@ViewBag.FathersPhoto" alt="Father Photo Preview" style="@(string.IsNullOrEmpty(ViewBag.FathersPhoto) ? "display: none;" : "display: block;") max-width: 150px; max-height: 150px; margin-top: 10px; " />
    </div>
    <div class="form-group">
        <label>Father Signature</label>
        <input type="file" name="FatherSignature" id="FatherSignature" accept="image/*" class="form-control" onchange="previewImage(this, 'fatherSignaturePreview')" />
        <span class="text-danger" id="FatherSignatureError"></span>
        <img id="fatherSignaturePreview" src="@ViewBag.FathersSignature" alt="Father Signature Preview" style="@(string.IsNullOrEmpty(ViewBag.FathersSignature) ? "display: none;" : "display: block;") max-width: 150px; max-height: 150px; margin-top: 10px; " />
    </div>
    <div class="form-group">
        <label>Mother Photo</label>
        <input type="file" name="MotherPhoto" id="MotherPhoto" accept="image/*" class="form-control" onchange="previewImage(this, 'motherPhotoPreview')" />
        <span class="text-danger" id="MotherPhotoError"></span>
        <img id="motherPhotoPreview" src="@ViewBag.MothersPhoto" alt="Mother Photo Preview" style="@(string.IsNullOrEmpty(ViewBag.MothersPhoto) ? "display: none;" : "display: block;") max-width: 150px; max-height: 150px; margin-top: 10px; " />
    </div>

    <div class="form-group">
        <label>Mother Signature</label>
        <input type="file" name="MotherSignature" id="MotherSignature" accept="image/*" class="form-control" onchange="previewImage(this, 'motherSignaturePreview')" />
        <span class="text-danger" id="MotherSignatureError"></span>
        <img id="motherSignaturePreview" src="@ViewBag.MothersSignature" alt="Mother Signature Preview" style="@(string.IsNullOrEmpty(ViewBag.MothersSignature) ? "display: none;" : "display: block;") max-width: 150px; max-height: 150px; margin-top: 10px;" />
    </div>

    <div class="divider"></div>
    <div class="clearfix">
        <button type="submit" class="btn-shadow float-right btn-wide btn-pill mr-3 btn btn-outline-secondary">Next</button>

        <button type="button" onclick="loadStep(3)" class="btn-shadow btn-wide float-right btn-pill btn-hover-shine btn btn-primary">Previous</button>
    </div>
}


<script type="text/javascript">
    function ajaxSuccessUploadInfo(data) {
        if (data.result == true) {
            loadStep(5, 4, data.StudentInfoId);
        }
    };

    //document.querySelectorAll('input[type="file"]').forEach(input => {
    //    input.addEventListener('change', function () {
    //        if (this.files[0] && this.files[0].size > 200 * 1024) {
    //            alert(`${this.name} must be less than 200KB.`);
    //            this.value = "";
    //        }
    //    });
    //});
    /*document.getElementById('frmuploadImages').addEventListener('submit', function (e) {*/
    //$(document).on('ajax:begin', '#frmuploadImages', function (e) {
    function onUploadBegin(xhr) {
        let isValid = true;
        document.querySelectorAll('#frmuploadImages input[type="file"]').forEach(function (input) {
            const file = input.files[0];
            const errorSpan = document.getElementById(input.name + "Error");
            if (file && file.size > 200 * 1024) {
                isValid = false;
                errorSpan.textContent = `${input.name} must be less than 200KB.`;
                input.value = "";

                xhr.abort();
                return false; 
            }
        });
        return true;
        //if (!isValid) {
        //    e.preventDefault(); // Prevent form submission
        //    //alert(errorMessages.join('\n')); // Show all errors
        //}
        //});
    }

    function previewImage(input, imgPreviewId) {
        const preview = document.getElementById(imgPreviewId);
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = "block";
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>