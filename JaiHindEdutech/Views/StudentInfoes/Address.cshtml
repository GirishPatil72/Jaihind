@model JaiHindEdutech.Models.AddressInfoFormModel

@{
    Layout = null;
}

<style>
    :root {
        --app-bg: #f4f7fb;
        --app-surface: #ffffff;
        --app-border: #e5eaf1;
        --app-text: #1f2937;
        --app-muted: #6b7280;
        --app-primary: #1f4e79;
        --app-primary-hover: #163b5c;
        --app-accent: #02adee;
        --app-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
    }

    .address-shell {
        padding: 1.25rem .5rem;
    }

    .address-card {
        border: 0;
        border-radius: 18px;
        box-shadow: var(--app-shadow);
        overflow: hidden;
        background: var(--app-surface);
    }

    .address-card-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border-bottom: 1px solid var(--app-border);
        padding: 1rem 1.25rem;
    }

    .header-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(2, 173, 238, 0.12);
        color: #02ADEE;
        flex: 0 0 46px;
    }

    .header-title {
        font-weight: 700;
        margin-bottom: 0;
        color: #0f172a;
    }

    .header-subtitle {
        color: var(--app-muted);
        font-size: .95rem;
    }

    .section-card {
        background: #fff;
        border: 1px solid var(--app-border);
        border-radius: 16px;
        padding: 1rem 1.1rem;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
        margin-bottom: 1rem;
    }

    .section-label {
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--app-muted);
        margin-bottom: .85rem;
    }

    .address-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .42rem .75rem;
        border-radius: 999px;
        background: #eef6ff;
        color: var(--app-primary);
        font-weight: 700;
        font-size: .9rem;
        margin-bottom: .85rem;
    }

    .same-address-box {
        background: linear-gradient(135deg, #eef7ff 0%, #f8fbff 100%);
        border: 1px solid #dbeafe;
        border-radius: 14px;
        padding: .85rem 1rem;
        margin-bottom: 1rem;
    }

    .form-label {
        font-weight: 700;
        color: #334155;
        margin-bottom: .35rem;
    }

    .form-control {
        border-radius: 12px;
        border-color: #dbe3ee;
        min-height: 46px;
        box-shadow: none !important;
    }

    .form-control:focus {
        border-color: var(--app-accent);
        box-shadow: 0 0 0 0.2rem rgba(2, 173, 238, 0.12) !important;
    }

    .form-check-input {
        width: 1.1rem;
        height: 1.1rem;
        margin-top: .25rem;
    }

    .form-check-label {
        font-weight: 600;
        color: #334155;
    }

    .invalid-feedback {
        display: block;
    }

    .field-hint {
        font-size: .82rem;
        color: var(--app-muted);
        margin-top: .35rem;
    }

    .divider {
        height: 1px;
        background: var(--app-border);
        margin: 1.25rem 0;
    }

    .action-bar {
        background: #f8fbff;
        border: 1px solid var(--app-border);
        border-radius: 14px;
        padding: .9rem 1rem;
    }

    .btn {
        border-radius: 12px;
        font-weight: 700;
        padding: .7rem 1.15rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--app-primary) 0%, var(--app-primary-hover) 100%);
        border-color: var(--app-primary);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, var(--app-primary-hover) 0%, #0f2d46 100%);
        border-color: var(--app-primary-hover);
    }

    .btn-outline-secondary {
        border-radius: 12px;
        font-weight: 700;
    }

    @@media (max-width: 991.98px) {
        .address-shell {
            padding: .75rem .25rem;
        }
    }
</style>

@using (Ajax.BeginForm("AddressInfoPost", "StudentInfoes", null,
    new AjaxOptions
    {
        HttpMethod = "POST",
        InsertionMode = InsertionMode.Replace,
        OnSuccess = "ajaxSuccessAddressInfo(data)",
        UpdateTargetId = "wizardContainer"
    },
    new { encType = Model.encType, id = "frmSetAddress", name = "frmSetAddress", @class = "address-shell" }))
{
    @Html.HiddenFor(m => m.StudentInfoId)

    <div class="card address-card mx-auto col-md-10">
        <div class="address-card-header">
            <div class="d-flex align-items-center">
                <div class="header-icon d-inline-flex align-items-center justify-content-center me-3">
                    <i class="fa fa-map-marker-alt fa-lg"></i>
                </div>
                <div>
                    <h4 class="header-title">Address Information</h4>
                    <div class="header-subtitle">Enter permanent and present address details for the student.</div>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-lg-5">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger border-0 rounded-3" })

            @for (int i = 0; i < Model.Address.Count; i++)
            {
                @Html.HiddenFor(model => model.Address[i].StudentAddressInfoId)
                @Html.HiddenFor(model => model.Address[i].CreatedBy)
                @Html.HiddenFor(model => model.Address[i].CreatedOn)
                @Html.HiddenFor(model => model.Address[i].ModifiedBy)
                @Html.HiddenFor(model => model.Address[i].ModifiedOn)
                @Html.HiddenFor(model => model.Address[i].IsDeleted)
                @Html.HiddenFor(model => model.Address[i].AddressType, new { Value = Model.Address[i].AddressType })

                <div class="section-card">
                    <div class="address-badge">
                        <i class="fa fa-home"></i>
                        @(Model.Address[i].AddressType.ToString() == "PemanentAddress" ? "Permanent Address" : "Present Address")
                    </div>

                    @if (Model.Address[i].AddressType.ToString() == "PresentAddress")
                    {
                        <div class="same-address-box">
                            <div class="form-group form-check mb-0">
                                @Html.CheckBoxFor(m => m.Address[i].SameAsPermanent, new { @class = "form-check-input", @id = "sameAsPermanent" })
                                @Html.LabelFor(m => m.Address[i].SameAsPermanent, "Same as Permanent Address", new { @class = "form-check-label ms-2" })
                            </div>
                            <div class="field-hint">
                                When selected, present address fields can be copied from the permanent address.
                            </div>
                        </div>
                    }

                    <div class="section-label">Address Details</div>

                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Address[i].HouseNo, new { @class = "form-label" })
                                @Html.EditorFor(model => model.Address[i].HouseNo, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control " + (ViewData.ModelState[string.Format("Address[{0}].HouseNo", i)] != null && ViewData.ModelState[string.Format("Address[{0}].HouseNo", i)].Errors.Any() ? "is-invalid" : ""),
                                        @placeholder = "House No",
                                        @id = string.Format("HouseNo_{0}", i)
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.Address[i].HouseNo, "", new { @class = "error invalid-feedback" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Address[i].Area, new { @class = "form-label" })
                                @Html.EditorFor(model => model.Address[i].Area, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control " + (ViewData.ModelState[string.Format("Address[{0}].Area", i)] != null && ViewData.ModelState[string.Format("Address[{0}].Area", i)].Errors.Any() ? "is-invalid" : ""),
                                        @placeholder = "Area",
                                        @id = string.Format("Area_{0}", i)
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.Address[i].Area, "", new { @class = "error invalid-feedback" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Address[i].Village, new { @class = "form-label" })
                                @Html.EditorFor(model => model.Address[i].Village, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control " + (ViewData.ModelState[string.Format("Address[{0}].Village", i)] != null && ViewData.ModelState[string.Format("Address[{0}].Village", i)].Errors.Any() ? "is-invalid" : ""),
                                        @placeholder = "Village",
                                        @id = string.Format("Village_{0}", i)
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.Address[i].Village, "", new { @class = "error invalid-feedback" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Address[i].PO, new { @class = "form-label" })
                                @Html.EditorFor(model => model.Address[i].PO, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control " + (ViewData.ModelState[string.Format("Address[{0}].PO", i)] != null && ViewData.ModelState[string.Format("Address[{0}].PO", i)].Errors.Any() ? "is-invalid" : ""),
                                        @placeholder = "PO",
                                        @id = string.Format("PO_{0}", i)
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.Address[i].PO, "", new { @class = "error invalid-feedback" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Address[i].District, new { @class = "form-label" })
                                @Html.EditorFor(model => model.Address[i].District, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control " + (ViewData.ModelState[string.Format("Address[{0}].District", i)] != null && ViewData.ModelState[string.Format("Address[{0}].District", i)].Errors.Any() ? "is-invalid" : ""),
                                        @placeholder = "District",
                                        @id = string.Format("District_{0}", i)
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.Address[i].District, "", new { @class = "error invalid-feedback" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Address[i].City, new { @class = "form-label" })
                                @Html.EditorFor(model => model.Address[i].City, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control " + (ViewData.ModelState[string.Format("Address[{0}].City", i)] != null && ViewData.ModelState[string.Format("Address[{0}].City", i)].Errors.Any() ? "is-invalid" : ""),
                                        @placeholder = "City",
                                        @id = string.Format("City_{0}", i)
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.Address[i].City, "", new { @class = "error invalid-feedback" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Address[i].State, new { @class = "form-label" })
                                @Html.EditorFor(model => model.Address[i].State, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control " + (ViewData.ModelState[string.Format("Address[{0}].State", i)] != null && ViewData.ModelState[string.Format("Address[{0}].State", i)].Errors.Any() ? "is-invalid" : ""),
                                        @placeholder = "State",
                                        @id = string.Format("State_{0}", i)
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.Address[i].State, "", new { @class = "error invalid-feedback" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Address[i].Zip, new { @class = "form-label" })
                                @Html.EditorFor(model => model.Address[i].Zip, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control " + (ViewData.ModelState[string.Format("Address[{0}].Zip", i)] != null && ViewData.ModelState[string.Format("Address[{0}].Zip", i)].Errors.Any() ? "is-invalid" : ""),
                                        @placeholder = "Zip",
                                        @id = string.Format("Zip_{0}", i)
                                    }
                                })
                                @Html.ValidationMessageFor(model => model.Address[i].Zip, "", new { @class = "error invalid-feedback" })
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="divider"></div>

            <div class="action-bar">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="field-hint mb-0">
                        Review the address details before continuing to the next step.
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" onclick="loadStep(2)" class="btn btn-outline-secondary btn-lg px-4">
                            <i class="fa fa-arrow-left me-2"></i> Previous
                        </button>
                        <button type="submit" class="btn btn-primary btn-lg px-4">
                            <i class="fa fa-arrow-right me-2"></i> Next
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    function ajaxSuccessAddressInfo(data) {
        if (data.result == true) {
            loadStep(4, 3, data.StudentInfoId);
        }
    };

    $(document).ready(function () {
        $('#sameAsPermanent').change(function () {
            var index0 = 0;
            var index1 = 1;

            if ($(this).is(':checked')) {
                $('#HouseNo_' + index1).val($('#HouseNo_' + index0).val());
                $('#Area_' + index1).val($('#Area_' + index0).val());
                $('#Village_' + index1).val($('#Village_' + index0).val());
                $('#PO_' + index1).val($('#PO_' + index0).val());
                $('#District_' + index1).val($('#District_' + index0).val());
                $('#City_' + index1).val($('#City_' + index0).val());
                $('#State_' + index1).val($('#State_' + index0).val());
                $('#Zip_' + index1).val($('#Zip_' + index0).val());

                // Optional: make fields readonly
                $(`#HouseNo_${index1}, #Area_${index1}, #Village_${index1}, #PO_${index1}, #District_${index1}, #City_${index1}, #State_${index1}, #Zip_${index1}`).prop('readonly', true);
            } else {
                $(`#HouseNo_${index1}, #Area_${index1}, #Village_${index1}, #PO_${index1}, #District_${index1}, #City_${index1}, #State_${index1}, #Zip_${index1}`).val('').prop('readonly', false);
            }
        });
    });
</script>
