                <div class="section-note mt-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="text-muted">
                            Review the entered details before proceeding to the next step.
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn-shadow btn-wide btn-pill btn-hover-shine btn btn-primary">Next</button>
