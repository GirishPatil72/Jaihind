                                            { "type", "number" },
                                            { "step", "0.01" },
                                            { "oninput", "calculateFees()" },
                                            { "id", "Scholarship" }
                                        };

                                            if (!isAdmin)
                                            {
                                                scholarshipAttributes["readonly"] = "readonly";
                                            }
                                        }

                                        @Html.TextBoxFor(model => model.Scholarship, scholarshipAttributes)
