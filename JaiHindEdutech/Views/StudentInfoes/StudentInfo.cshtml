<style>
    :root {
        --app-bg: #f4f7fb;
        --app-surface: #ffffff;
        --app-border: #e5eaf1;
        --app-text: #1f2937;
        --app-muted: #6b7280;
        --app-primary: #1f4e79;
        --app-primary-hover: #163b5c;
        --app-accent: #02adee;
        --app-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
    }

    body {
        background: var(--app-bg);
        color: var(--app-text);
    }

    .student-shell {
        padding: 1.25rem .5rem;
    }

    .student-card {
        border: 0;
        border-radius: 18px;
        box-shadow: var(--app-shadow);
        overflow: hidden;
        background: var(--app-surface);
    }

    .student-card-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border-bottom: 1px solid var(--app-border);
        padding: 1rem 1.25rem;
    }

    .header-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(2, 173, 238, 0.12);
        color: #02ADEE;
        flex: 0 0 46px;
    }

    .header-title {
        font-weight: 700;
        margin-bottom: 0;
        color: #0f172a;
    }

    .header-subtitle {
        color: var(--app-muted);
        font-size: .95rem;
    }

    .section-card {
        background: #fff;
        border: 1px solid var(--app-border);
        border-radius: 16px;
        padding: 1rem 1.1rem;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
        height: 100%;
    }

    .section-label {
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--app-muted);
        margin-bottom: .85rem;
    }

    .form-label {
        font-weight: 700;
        color: #334155;
        margin-bottom: .35rem;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        border-color: #dbe3ee;
        min-height: 46px;
        box-shadow: none !important;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--app-accent);
        box-shadow: 0 0 0 0.2rem rgba(2, 173, 238, 0.12) !important;
    }

    .form-check-input {
        width: 1.1rem;
        height: 1.1rem;
        margin-top: .25rem;
    }

    .field-hint {
        font-size: .82rem;
        color: var(--app-muted);
        margin-top: .35rem;
    }

    .info-box {
        background: linear-gradient(135deg, #eef7ff 0%, #f8fbff 100%);
        border: 1px solid #dbeafe;
        border-radius: 16px;
        padding: 1rem 1.1rem;
        color: #334155;
    }

    .info-box .info-title {
        font-weight: 700;
        color: var(--app-primary);
        margin-bottom: .35rem;
    }

    .divider {
        height: 1px;
        background: var(--app-border);
        margin: 1.25rem 0;
    }

    .btn {
        border-radius: 12px;
        font-weight: 700;
        padding: .7rem 1.15rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--app-primary) 0%, var(--app-primary-hover) 100%);
        border-color: var(--app-primary);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, var(--app-primary-hover) 0%, #0f2d46 100%);
        border-color: var(--app-primary-hover);
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .72rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: .88rem;
        background: #eef6ff;
        color: var(--app-primary);
    }

    .section-note {
        background: #f8fbff;
        border: 1px solid #e5eaf1;
        border-radius: 14px;
        padding: .9rem 1rem;
        color: #475569;
    }

    .invalid-feedback {
        display: block;
    }

    @@media (max-width: 991.98px) {
        .student-shell {
            padding: .75rem .25rem;
        }
    }
</style>

@using (Ajax.BeginForm("StudentInfoPost", "StudentInfoes", null, new AjaxOptions
{
    HttpMethod = "POST",
    InsertionMode = InsertionMode.Replace,
    OnSuccess = "ajaxSuccessStudentInfo(data)",
    UpdateTargetId = "wizardContainer"
}, new { encType = Model.encType, id = "frmStudentInfo", name = "frmStudentInfo", @class = "student-shell" }))
{
    @Html.HiddenFor(model => model.ClassName, new { id = "hdnClassName" })
    @Html.HiddenFor(model => model.Stream, new { id = "hdnStreamName" })
    @Html.HiddenFor(model => model.CoachingCentreId, new { id = "hdnCoachingCentre" })

    @Html.HiddenFor(model => model.AddmissionFormId)
    @Html.HiddenFor(model => model.CollegeInfoId, new { Value = ViewBag.collegeId ?? Model.CollegeInfoId })
    @Html.HiddenFor(model => model.CollegeName, new { Value = ViewBag.collegeName ?? Model.CollegeName })
    @Html.HiddenFor(model => model.StudentInfoId)
    @Html.HiddenFor(model => model.CreatedBy)
    @Html.HiddenFor(model => model.CreatedOn)
    @Html.HiddenFor(model => model.ModifiedBy)
    @Html.HiddenFor(model => model.ModifiedOn)
    @Html.HiddenFor(model => model.IsActive)
    @Html.HiddenFor(model => model.IsDeleted)
    @Html.HiddenFor(model => model.FullName)

    @*<form id="signupForm" class="col-md-10 mx-auto" method="post" action="" novalidate="novalidate">*@
    @*@{
            var isInvalidClass = (ViewData.ModelState["FirstName"] != null && ViewData.ModelState["FirstName"].Errors.Any()) ? "is-invalid" : "";
        }*@

    <div class="card student-card mx-auto col-md-10">
        <div class="student-card-header">
            <div class="d-flex align-items-center">
                <div class="header-icon d-inline-flex align-items-center justify-content-center me-3">
                    <i class="fa fa-user-graduate fa-lg"></i>
                </div>
                <div>
                    <h4 class="header-title">Student Information</h4>
                    <div class="header-subtitle">Enter the student profile, demographic details, and fee information.</div>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-lg-5">
            @*@Html.ValidationSummary(true, "", new { @class = "alert alert-danger border-0 rounded-3" })*@

            <div class="row g-4">
                <div class="col-12">
                    <div class="section-card">
                        <div class="section-label">Name Details</div>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.FirstName, new { @class = "form-label" })
                                    @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control " + (ViewData.ModelState["FirstName"] != null && ViewData.ModelState["FirstName"].Errors.Any() ? "is-invalid" : ""), @placeholder = "First name" } })
                                    @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "error invalid-feedback" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.MiddleName, new { @class = "form-label" })
                                    @Html.EditorFor(model => model.MiddleName, new { htmlAttributes = new { @class = "form-control " + (ViewData.ModelState["MiddleName"] != null && ViewData.ModelState["MiddleName"].Errors.Any() ? "is-invalid" : ""), @placeholder = "Middle name" } })
                                    @Html.ValidationMessageFor(model => model.MiddleName, "", new { @class = "error invalid-feedback" })
                                    @*<input type="text" class="form-control is-invalid" id="lastname" name="lastname" placeholder="Last name" aria-describedby="lastname-error"><em id="lastname-error" class="error invalid-feedback">Please enter your lastname</em>*@
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LastName, new { @class = "form-label" })
                                    @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control " + (ViewData.ModelState["LastName"] != null && ViewData.ModelState["LastName"].Errors.Any() ? "is-invalid" : ""), @placeholder = "Last name" } })
                                    @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "error invalid-feedback" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="section-card">
                        <div class="section-label">Personal Details</div>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.DateOfBirth, new { @class = "form-label" })
                                    @*@Html.TextBoxFor(model => model.DateOfBirth, new { htmlAttributes = new { @class = "form-control" + (ViewData.ModelState["DateOfBirth"] != null && ViewData.ModelState["DateOfBirth"].Errors.Any() ? "is-invalid" : ""), @placeholder = "Date Of Birth", @maxlength = "10" } })*@

                                    @Html.TextBoxFor(model => model.DateOfBirth, new
                                    {
                                        @class = "form-control" + (ViewData.ModelState["DateOfBirth"] != null && ViewData.ModelState["DateOfBirth"].Errors.Any() ? "is-invalid" : ""),
                                        @placeholder = "Date Of Birth",
                                        @maxlength = "10",
                                        @Value = Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy") : ""
                                    })

                                    @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "error invalid-feedback" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Gender, new { @class = "form-label" })
                                    @Html.DropDownListFor(model => model.Gender, (SelectList)GenderList, "-- Select Gender --", new { @class = "form-control " + (ViewData.ModelState["Gender"] != null && ViewData.ModelState["Gender"].Errors.Any() ? "is-invalid" : "") })
                                    @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "error invalid-feedback" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.AadharNo, new { @class = "form-label" })
                                    @Html.EditorFor(model => model.AadharNo, new
                                    {
