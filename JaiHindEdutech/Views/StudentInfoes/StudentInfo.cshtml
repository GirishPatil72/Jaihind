                                        type = "number",
                                        step = "0.01",
                                        id = "FeesPayable",
                                        @readonly = "readonly"
                                    })
                                    @Html.ValidationMessageFor(model => model.FeesPayable, "", new { @class = "error invalid-feedback" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

