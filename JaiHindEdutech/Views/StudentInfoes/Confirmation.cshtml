<script type="text/javascript">
    function ajaxSuccessConfirmation(data) {
        if (data.result == true) {
            window.location.href = '@Url.Action("RegistrationSuccess", "StudentInfoes")?studentInfoId=' + data.StudentInfoId + '&RollNumber=' + data.RollNumber;
        }
        else {
            loadStep(8, 7, data.StudentInfoId);
        }
    };
</script>
