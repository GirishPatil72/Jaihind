@model JaiHindEdutech.Models.AdmissionConfirmationModel
@using (Ajax.BeginForm("ConfirmationPost", "StudentInfoes", null, new AjaxOptions { HttpMethod = "POST", InsertionMode = InsertionMode.Replace, OnSuccess = "ajaxSuccessConfirmation(data)", UpdateTargetId = "wizardContainer" }, new { id = "frmConfirmation", name = "frmConfirmation", @class = "col-md-12 mx-auto" }))
{
    <div class="clearfix">
        <button type="submit" class="btn-shadow btn-wide btn-pill btn-hover-shine btn btn-primary">Submit</button>
    </div>
    @Html.HiddenFor(model => model.StudentInfoId)

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Student Details</h4>
        <button type="button" onclick="loadStep(1)" class="btn-shadow btn-wide float-right btn-pill btn-hover-shine btn btn-primary">Edit Student Info</button>
    </div>

    <dl class="card p-3" style="background-color: #FFE5BB">
        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.FirstName)</th>
                    <td>@Model.studentInfoModel.FirstName</td>

                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.MiddleName)</th>
                    <td>@Model.studentInfoModel.MiddleName</td>

                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.LastName)</th>
                    <td>@Model.studentInfoModel.LastName</td>
                </tr>
                <tr>
                    <th scope="row" colspan="1">@Html.LabelFor(model => model.studentInfoModel.FullName)</th>
                    <td colspan="3">@Model.studentInfoModel.FullName</td>

                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.DateOfBirth)</th>
                    <td>@(Model.studentInfoModel.DateOfBirth.HasValue ? Model.studentInfoModel.DateOfBirth.Value.ToString("dd-MM-yyyy") : "N/A")</td>
                </tr>
                <tr>
                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.Gender)</th>
                    <td>@Model.studentInfoModel.Gender</td>

                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.AadharNo)</th>
                    <td>@Model.studentInfoModel.AadharNo</td>

                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.IsSingleGirlChild)</th>
                    <td>@(Model.studentInfoModel.IsSingleGirlChild ? "Yes" : "No")</td>
                </tr>
                <tr>
                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.BloodGroup)</th>
                    <td>@Model.studentInfoModel.BloodGroup</td>

                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.Nationality)</th>
                    <td>@Model.studentInfoModel.Nationality</td>

                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.Category)</th>
                    <td>@Model.studentInfoModel.Category</td>
                </tr>
                <tr>
                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.MobileNo)</th>
                    <td>@Model.studentInfoModel.MobileNo</td>

                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.EmailId)</th>
                    <td>@Model.studentInfoModel.EmailId</td>

                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.Domicile)</th>
                    <td>@Model.studentInfoModel.Domicile</td>
                </tr>
                <tr>
                    <th scope="row">@Html.LabelFor(model => model.studentInfoModel.Remark)</th>
                    <td colspan="5">@Model.studentInfoModel.Remark</td>
                </tr>
            </tbody>
        </table>
    </dl>
    <div class="divider"></div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Parents Details</h4>
        <button type="button" onclick="loadStep(2)" class="btn-shadow btn-wide float-right btn-pill btn-hover-shine btn btn-primary">Edit Parents Info</button>
    </div>
    <dl class="card p-3" style="background-color: #FFE5BB">

        @for (int i = 0; i < Model.ParentInfoFormModel.Parents.Count; i++)
        {
            <h5>@Model.ParentInfoFormModel.Parents[i].ParentType.ToString()</h5>
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th scope="row" colspan="1">@Html.LabelFor(model => model.ParentInfoFormModel.Parents[i].FullName)</th>
                        <td colspan="5">@Model.ParentInfoFormModel.Parents[i].FullName</td>
                    </tr>
                    <tr>
                        <th scope="row">@Html.LabelFor(model => model.ParentInfoFormModel.Parents[i].AadharNo)</th>
                        <td>@Model.ParentInfoFormModel.Parents[i].AadharNo</td>

                        <th scope="row">@Html.LabelFor(model => model.ParentInfoFormModel.Parents[i].Occupation)</th>
                        <td>@Model.ParentInfoFormModel.Parents[i].Occupation</td>

                        <th scope="row">@Html.LabelFor(model => model.ParentInfoFormModel.Parents[i].AnnualIncome)</th>
                        <td>@Model.ParentInfoFormModel.Parents[i].AnnualIncome</td>
                    </tr>
                    <tr>
                        <th scope="row">@Html.LabelFor(model => model.ParentInfoFormModel.Parents[i].MobileNo)</th>
                        <td>@Model.ParentInfoFormModel.Parents[i].MobileNo</td>

                        <th scope="row">@Html.LabelFor(model => model.ParentInfoFormModel.Parents[i].EmailId)</th>
                        <td colspan="3">@Model.ParentInfoFormModel.Parents[i].EmailId</td>
                    </tr>
                </tbody>
            </table>
        }
    </dl>

    <div class="divider"></div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Address Details</h4>
        <button type="button" onclick="loadStep(3)" class="btn-shadow btn-wide float-right btn-pill btn-hover-shine btn btn-primary">Edit Address Info</button>
    </div>
    <dl class="card p-3" style="background-color: #FFE5BB">

        @for (int i = 0; i < Model.addressInfoFormModel.Address.Count; i++)
        {

            string AddressType = "";

            if (Model.addressInfoFormModel.Address[i].AddressType.ToString() == "PemanentAddress")
            {
                AddressType = "Permanent Address";
            }
            else
            {
                AddressType = "Present Address";
            };
            <h5>
                @AddressType
            </h5>
            if (Model.addressInfoFormModel.Address[i].AddressType.ToString() == "PresentAddress")
            {
                <div class="form-group form-check">
                    @Html.CheckBoxFor(m => m.addressInfoFormModel.Address[i].SameAsPermanent, new { @class = "form-check-input", @id = "sameAsPermanent", onclick = "return false;" })
                    @Html.LabelFor(m => m.addressInfoFormModel.Address[i].SameAsPermanent, "Same as Permanent Address", new { @class = "form-check-label" })
                </div>
            }
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th scope="row">@Html.LabelFor(model => model.addressInfoFormModel.Address[i].HouseNo)</th>
                        <td>@Model.addressInfoFormModel.Address[i].HouseNo</td>

                        <th scope="row">@Html.LabelFor(model => model.addressInfoFormModel.Address[i].Area)</th>
                        <td colspan="3">@Model.addressInfoFormModel.Address[i].Area</td>
                    </tr>
                    <tr>
                        <th scope="row">@Html.LabelFor(model => model.addressInfoFormModel.Address[i].Village)</th>
                        <td>@Model.addressInfoFormModel.Address[i].Village</td>

                        <th scope="row">@Html.LabelFor(model => model.addressInfoFormModel.Address[i].PO)</th>
                        <td>@Model.addressInfoFormModel.Address[i].PO</td>

                        <th scope="row">@Html.LabelFor(model => model.addressInfoFormModel.Address[i].City)</th>
                        <td>@Model.addressInfoFormModel.Address[i].City</td>
                    </tr>
                    <tr>
                        <th scope="row">@Html.LabelFor(model => model.addressInfoFormModel.Address[i].District)</th>
                        <td>@Model.addressInfoFormModel.Address[i].District</td>

                        <th scope="row">@Html.LabelFor(model => model.addressInfoFormModel.Address[i].State)</th>
                        <td>@Model.addressInfoFormModel.Address[i].State</td>

                        <th scope="row">@Html.LabelFor(model => model.addressInfoFormModel.Address[i].Zip)</th>
                        <td>@Model.addressInfoFormModel.Address[i].Zip</td>
                    </tr>
                </tbody>
            </table>
        }
    </dl>
    <div class="divider"></div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Upload Images</h4>
        <button type="button" onclick="loadStep(4)" class="btn-shadow btn-wide float-right btn-pill btn-hover-shine btn btn-primary">Edit Upload Images</button>
    </div>
    <dl class="card p-3" style="background-color: #FFE5BB">
        <table class="table table-bordered">
            @foreach (var image in Model.uploadedImagesModel)
            {
                <tr>
                    <th>@image.DocumentType</th>
                    <td>
                        @if (!string.IsNullOrEmpty(image.DocumentURL))
                        {
                            <img src="@image.DocumentURL" alt="Student Photo" style="max-width: 150px; max-height: 150px;" />
                        }
                        else
                        {
                            <span>No photo available</span>
                        }
                    </td>
                </tr>
            }
        </table>
    </dl>



    <div class="divider"></div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Prev. Academic Details</h4>
        <button type="button" onclick="loadStep(5)" class="btn-shadow btn-wide float-right btn-pill btn-hover-shine btn btn-primary">Edit Prev. Academic Info</button>
    </div>
    <dl class="card p-3" style="background-color: #FFE5BB">
        <h5>10th Class Info</h5>
        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.TenthClass.ExamName)</th>
                    <td>@Model.previousAcademicInfoModel.TenthClass.ExamName</td>

                    <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.TenthClass.Board)</th>
                    <td>@Model.previousAcademicInfoModel.TenthClass.Board</td>

                    <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.TenthClass.ExamSeatNo)</th>
                    <td>@Model.previousAcademicInfoModel.TenthClass.ExamSeatNo</td>
                </tr>
                <tr>
                    <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.TenthClass.EligibilityCertNo)</th>
                    <td>@Model.previousAcademicInfoModel.TenthClass.EligibilityCertNo</td>

                    <th scope="row" colspan="1">@Html.LabelFor(model => model.previousAcademicInfoModel.TenthClass.SchoolOrCollege)</th>
                    <td colspan="3">@Model.previousAcademicInfoModel.TenthClass.SchoolOrCollege</td>
                </tr>
                <tr>
                    <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.TenthClass.MonthYearOfPassing)</th>
                    <td>@Model.previousAcademicInfoModel.TenthClass.MonthYearOfPassing</td>

                    <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.TenthClass.TotalMarks)</th>
                    <td>@Model.previousAcademicInfoModel.TenthClass.TotalMarks</td>

                    <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.TenthClass.Percentage)</th>
                    <td>@Model.previousAcademicInfoModel.TenthClass.Percentage</td>
                </tr>
            </tbody>
        </table>
        @if (Model.previousAcademicInfoModel.EleventhClass.StudentPreviousAcademicInfoId > 0)
        {
            <h5>11th Class Info</h5>
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.EleventhClass.ExamName)</th>
                        <td>@Model.previousAcademicInfoModel.EleventhClass.ExamName</td>

                        <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.EleventhClass.Board)</th>
                        <td>@Model.previousAcademicInfoModel.EleventhClass.Board</td>

                        <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.EleventhClass.ExamSeatNo)</th>
                        <td>@Model.previousAcademicInfoModel.EleventhClass.ExamSeatNo</td>
                    </tr>
                    <tr>
                        <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.EleventhClass.EligibilityCertNo)</th>
                        <td>@Model.previousAcademicInfoModel.EleventhClass.EligibilityCertNo</td>

                        <th scope="row" colspan="1">@Html.LabelFor(model => model.previousAcademicInfoModel.EleventhClass.SchoolOrCollege)</th>
                        <td colspan="3">@Model.previousAcademicInfoModel.EleventhClass.SchoolOrCollege</td>
                    </tr>
                    <tr>
                        <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.EleventhClass.MonthYearOfPassing)</th>
                        <td>@Model.previousAcademicInfoModel.EleventhClass.MonthYearOfPassing</td>

                        <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.EleventhClass.TotalMarks)</th>
                        <td>@Model.previousAcademicInfoModel.EleventhClass.TotalMarks</td>

                        <th scope="row">@Html.LabelFor(model => model.previousAcademicInfoModel.EleventhClass.Percentage)</th>
                        <td>@Model.previousAcademicInfoModel.EleventhClass.Percentage</td>
                    </tr>
                </tbody>
            </table>
        }
    </dl>


    <div class="divider"></div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Subjects & Documents Selected</h4>
        <button type="button" onclick="loadStep(6)" class="btn-shadow btn-wide float-right btn-pill btn-hover-shine btn btn-primary">Edit Subjects & Documents</button>
    </div>
    <dl class="card p-3" style="background-color: #FFE5BB">
        <div class="container">
            <h4>Subject Selection</h4>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.subjectSelectionModel.English, new { @class = "form-check-input", id = "English", onclick = "return false;" })
                        <label class="form-check-label" for="English">
                            English
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.subjectSelectionModel.Physics, new { @class = "form-check-input", id = "Physics", onclick = "return false;" })
                        <label class="form-check-label" for="Physics">
                            Physics
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.subjectSelectionModel.Chemistry, new { @class = "form-check-input", id = "Chemistry", onclick = "return false;" })
                        <label class="form-check-label" for="Chemistry">
                            Chemistry
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.subjectSelectionModel.Mathemcatics, new { @class = "form-check-input", id = "Mathemcatics", onclick = "return false;" })
                        <label class="form-check-label" for="Mathemcatics">Mathematics</label>
                    </div>
                </div>
                <div class="col-md-3 border-start" style="border-left: 1px solid #ccc;">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.subjectSelectionModel.Biology, new { @class = "form-check-input", id = "Biology", onclick = "return false;" })
                        <label class="form-check-label" for="Biology">Biology</label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.subjectSelectionModel.CropScience, new { @class = "form-check-input", id = "CropScience", onclick = "return false;" })
                        <label class="form-check-label" for="CropScience">Crop Science</label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.subjectSelectionModel.Geography, new { @class = "form-check-input", id = "Geography", onclick = "return false;" })
                        <label class="form-check-label" for="Geography">Geography</label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.subjectSelectionModel.InformaticsPractices, new { @class = "form-check-input", id = "InformaticsPractices", onclick = "return false;" })
                        <label class="form-check-label" for="InformaticsPractices">Informatics Practices(IP)</label>
                    </div>
                </div>
                <div class="col-md-3 border-start" style="border-left: 1px solid #ccc;">
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.subjectSelectionModel.Marathi, new { @class = "form-check-input", id = "Marathi", onclick = "return false;" })
                        <label class="form-check-label" for="Marathi">
                            Marathi
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.subjectSelectionModel.Hindi, new { @class = "form-check-input", id = "Hindi", onclick = "return false;" })
                        <label class="form-check-label" for="Hindi">
                            Hindi
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.subjectSelectionModel.ComputerScience, new { @class = "form-check-input", id = "ComputerScience", onclick = "return false;" })
                        <label class="form-check-label" for="ComputerScience">
                            Computer Science(CS)
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.subjectSelectionModel.InformationTechnology, new { @class = "form-check-input", id = "InformationTechnology", onclick = "return false;" })
                        <label class="form-check-label" for="InformationTechnology">
                            Information Technology(IT)
                        </label>
                    </div>
                </div>

                <div class="col-md-3 border-start">
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.subjectSelectionModel.EVS, new { @class = "form-check-input", id = "EVS", onclick = "return false;" })
                        <label class="form-check-label" for="EVS">
                            Environment Science(ES)
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.subjectSelectionModel.PhysicalEducation, new { @class = "form-check-input", id = "PhysicalEducation", onclick = "return false;" })
                        <label class="form-check-label" for="PhysicalEducation">
                            Physical Education(PE)
                        </label>
                    </div>
                </div>
            </div>
            <div class="divider"></div>
            <h4>Document Selection</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.ClassXMarksheet, new { @class = "form-check-input", id = "ClassXMarksheet", onclick = "return false;" })
                        <label class="form-check-label" for="ClassXMarksheet">
                            Class X Marksheet
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.ClassXIMarksheet, new { @class = "form-check-input", id = "ClassXIMarksheet", onclick = "return false;" })
                        <label class="form-check-label" for="ClassXIMarksheet">
                            Class XI Marksheet
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.SchoolLC, new { @class = "form-check-input", id = "SchoolLC", onclick = "return false;" })
                        <label class="form-check-label" for="SchoolLC">
                            School/Jr College Leaving Certificate (LC)
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.CasteCertificate, new { @class = "form-check-input", id = "CasteCertificate", onclick = "return false;" })
                        <label class="form-check-label" for="CasteCertificate">
                            Caste Certificate
                        </label>
                    </div>

                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.GapCertificate, new { @class = "form-check-input", id = "GapCertificate", onclick = "return false;" })
                        <label class="form-check-label" for="GapCertificate">
                            Gap Certificate
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.SnglieGirlChild, new { @class = "form-check-input", id = "SnglieGirlChild", onclick = "return false;" })
                        <label class="form-check-label" for="SnglieGirlChild">
                            Snglie Girl Child Certificate
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.AadharFather, new { @class = "form-check-input", id = "AadharFather", onclick = "return false;" })
                        <label class="form-check-label" for="AadharFather">
                            Aadhar (Father)
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.ElegibilityCert, new { @class = "form-check-input", id = "ElegibilityCert", onclick = "return false;" })
                        <label class="form-check-label" for="ElegibilityCert">
                            Elegibility Certificate
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.AadharCard, new { @class = "form-check-input", id = "AadharCard", onclick = "return false;" })
                        <label class="form-check-label" for="AadharCard">
                            Aadhar Card
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.PassingCert, new { @class = "form-check-input", id = "PassingCert", onclick = "return false;" })
                        <label class="form-check-label" for="PassingCert">
                            Passing Certificate
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.PassportSizePhoto, new { @class = "form-check-input", id = "PassportSizePhoto", onclick = "return false;" })
                        <label class="form-check-label" for="PassportSizePhoto">
                            3 Passport Size Photos
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.CopyOfLOC, new { @class = "form-check-input", id = "CopyOfLOC", onclick = "return false;" })
                        <label class="form-check-label" for="CopyOfLOC">
                            Copy Of LOC
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.EBCCertificate, new { @class = "form-check-input", id = "EBCCertificate", onclick = "return false;" })
                        <label class="form-check-label" for="EBCCertificate">
                            EBC Certificate
                        </label>
                    </div>
                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.documentSelectionModel.AadharMother, new { @class = "form-check-input", id = "AadharMother", onclick = "return false;" })
                        <label class="form-check-label" for="AadharMother">
                            Aadhar (Mother)
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </dl>

    <div class="divider"></div>
    <div class="clearfix">
        <button type="submit" class="btn-shadow btn-wide float-right btn-pill btn-hover-shine btn btn-primary">Submit</button>
    </div>
}
<script type="text/javascript">
    function ajaxSuccessConfirmation(data) {
        //data.RoolNumber
        if (data.result == true) {
            window.location.href = '@Url.Action("RegistrationSuccess", "StudentInfoes")?studentInfoId=' + data.StudentInfoId + '&RollNumber=' + data.RollNumber;
        }
        else {
            loadStep(8, 7, data.StudentInfoId);
        }
    };
</script>
