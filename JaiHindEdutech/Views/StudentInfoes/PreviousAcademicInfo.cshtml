<script type="text/javascript">
    function ajaxSuccessAcademicInfo(data) {
        if (data.result == true) {
            loadStep(6, 5, data.StudentInfoId);
        }
    };
    $(function () {
        function toggleEleventhClassForm() {
            if ($('#SelectedClass').val().includes("12th")) {
                $('#eleventhClassForm').slideDown();
            } else {
                $('#eleventhClassForm').slideUp();
            }
        }

        $('#SelectedClass').change(toggleEleventhClassForm);
        toggleEleventhClassForm(); // Call on load
    });
</script>
