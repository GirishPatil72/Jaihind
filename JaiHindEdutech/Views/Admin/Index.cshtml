@model IEnumerable<JaiHindEdutech.Models.UserModel>
@using System.Linq

@{
    ViewBag.Title = "User Management";
    Layout = "~/Views/Shared/_Layout1.cshtml";
    var records = Model != null ? Model.ToList() : new List<JaiHindEdutech.Models.UserModel>();
}

<style>
    .grid-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .grid-card-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
    }

    .icon-badge {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(2, 173, 238, 0.12);
        color: #02ADEE;
    }

    .table thead th {
        background: #eaf2f8;
        color: #1f4e79;
        font-weight: 700;
        white-space: nowrap;
    }

    .table tbody tr:hover {
        background: #f8fbff;
    }

    .badge-role {
        border-radius: 999px;
        padding: .45rem .75rem;
        font-weight: 600;
    }
</style>

<div class="container-fluid py-4">
    <div class="card grid-card">
        <div class="card-header grid-card-header py-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <div class="icon-badge d-inline-flex align-items-center justify-content-center me-3">
                        <i class="fa fa-users fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-semibold">User Management</h4>
                        <div class="text-muted">Manage users, roles, and permissions.</div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    @Html.ActionLink("Create User", "CreateUser", "Admin", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>User Name</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th style="width:220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (records.Any())
                        {
                            foreach (var item in records)
                            {
                                <tr>
                                    <td>@item.UserName</td>
                                    <td>@item.FullName</td>
                                    <td>@item.Email</td>
                                    <td>
                                        <span class="badge bg-info badge-role text-white">@item.RoleName</span>
                                    </td>
                                    <td>
                                        @if (item.IsActive == true)
                                        {
                                            <span class="badge bg-success badge-role">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary badge-role">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            @Html.ActionLink("Edit", "EditUser", "Admin", new { id = item.UserId }, new { @class = "btn btn-sm btn-warning" })
                                            @Html.ActionLink("Rights", "UserRights", "Admin", new { id = item.UserId }, new { @class = "btn btn-sm btn-info text-white" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No users found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>