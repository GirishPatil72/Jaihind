@model JaiHindEdutech.Models.AdmissionConfirmationModel
@using System.Web.Configuration
@using System.Linq
@{
    ViewBag.Title = "GenerateFormPDF";
    Layout = null;

    var dummyPhotoUrl = Url.Content("~/Content/assets/images/avatars/1.jpg");
    var dummySignatureUrl = dummyPhotoUrl;

    //var uploadedImages = Model != null && Model.uploadedImagesModel != null
    //    ? Model.uploadedImagesModel
    //    : new List<JaiHindEdutech.Entity.DocumentSubmitted>();

    var uploadedImages = Model != null && Model.uploadedImagesModel != null
       ? Model.uploadedImagesModel
       : new List<JaiHindEdutech.Models.UploadedImagesModel>();

    var studentPhoto = uploadedImages.FirstOrDefault(x =>
x.DocumentOwner == "Student" &&
x.DocumentType == "StudentPhoto" &&
!string.IsNullOrWhiteSpace(x.DocumentURL));
    var studentPhotoUrl = studentPhoto != null && !string.IsNullOrWhiteSpace(studentPhoto.DocumentURL)
        ? studentPhoto.DocumentURL
        : dummyPhotoUrl;

    var studentSignature = uploadedImages.FirstOrDefault(x =>
        x.DocumentOwner == "Student" &&
        x.DocumentType == "StudentSignature" &&
        !string.IsNullOrWhiteSpace(x.DocumentURL));
    var studentSignatureUrl = studentSignature != null && !string.IsNullOrWhiteSpace(studentSignature.DocumentURL)
        ? studentSignature.DocumentURL
        : dummySignatureUrl;

    var fatherPhoto = uploadedImages.FirstOrDefault(x =>
        x.DocumentOwner == "Father" &&
        x.DocumentType == "FathersPhoto" &&
        !string.IsNullOrWhiteSpace(x.DocumentURL));
    var fatherPhotoUrl = fatherPhoto != null && !string.IsNullOrWhiteSpace(fatherPhoto.DocumentURL)
        ? fatherPhoto.DocumentURL
        : dummyPhotoUrl;

    var fatherSignature = uploadedImages.FirstOrDefault(x =>
        x.DocumentOwner == "Father" &&
        x.DocumentType == "FathersSignature" &&
        !string.IsNullOrWhiteSpace(x.DocumentURL));
    var fatherSignatureUrl = fatherSignature != null && !string.IsNullOrWhiteSpace(fatherSignature.DocumentURL)
        ? fatherSignature.DocumentURL
        : dummySignatureUrl;

    var motherPhoto = uploadedImages.FirstOrDefault(x =>
        x.DocumentOwner == "Mother" &&
        x.DocumentType == "MothersPhoto" &&
        !string.IsNullOrWhiteSpace(x.DocumentURL));
    var motherPhotoUrl = motherPhoto != null && !string.IsNullOrWhiteSpace(motherPhoto.DocumentURL)
        ? motherPhoto.DocumentURL
        : dummyPhotoUrl;

    var motherSignature = uploadedImages.FirstOrDefault(x =>
        x.DocumentOwner == "Mother" &&
        x.DocumentType == "MothersSignature" &&
        !string.IsNullOrWhiteSpace(x.DocumentURL));
    var motherSignatureUrl = motherSignature != null && !string.IsNullOrWhiteSpace(motherSignature.DocumentURL)
        ? motherSignature.DocumentURL
        : dummySignatureUrl;
}
<style>
    @@page {
        size: A4;
        margin: 12mm;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        a[href]::after {
            content: "" !important;
        }

        table {
            width: 100%;
            table-layout: fixed;
        }

        th, td {
            word-break: break-word;
        }

        dl.card,
        table,
        tr,
        td,
        th {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        h2, h3, h4, h5 {
            page-break-after: avoid;
        }

        body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        img {
            max-width: 100% !important;
            height: auto !important;
        }
    }

    /* keep this as spacing only, do not force a page break */
    .divider {
        margin: 12px 0;
    }

    body {
        font-family: Arial, sans-serif;
        font-size: 12px;
        margin: 0;
        padding: 0;
    }

    img {
        max-width: 150px;
        max-height: 150px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

    th, td {
        border: 1px solid #000;
        padding: 5px;
        vertical-align: top;
    }

    h4, h5 {
        margin-top: 20px;
        font-weight: bold;
    }

    .form-check {
        margin-bottom: 5px;
    }

    .form-check-label {
        margin-left: 5px;
    }

    .centered-header {
        background-color: black;
        color: white;
        text-align: center;
        padding: 1px 0;
    }

    .photo-cell {
        text-align: center;
        padding: 10px;
        vertical-align: top;
        width: 150px;
    }

    .photo-cell img.photo {
        width: 100%;
        height: 150px !important;
        object-fit: cover;
        border: 1px solid #000;
        margin: 5px 0;
        display: block;
    }

    .photo-cell img.signature {
        width: 100%;
        height: 50px;
        object-fit: contain;
        border: 1px solid #000;
        margin: 5px 0;
        display: block;
    }

    .photo-label {
        font-weight: bold;
        margin-bottom: 5px;
        font-size: 12px;
    }

    .checkbox-grid {
        width: 100%;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .checkbox-grid .column {
        float: left;
        width: 33.33%;
        box-sizing: border-box;
        padding: 0 10px;
    }

    .checkbox-grid .form-check {
        margin-bottom: 10px;
    }

    .checkbox-grid::after {
        content: "";
        display: table;
        clear: both;
    }

    h3 {
        margin-top: 0;
        font-size: 18px;
    }

    dl.card {
        border: 1px solid #ccc;
        margin-bottom: 6px;
    }

    .p-3 {
        padding: 10px;
    }
</style>

<div class="no-print" style="text-align: right; margin: 10px 0 15px 0;">
    <button type="button" class="btn btn-primary" onclick="window.print();">Print</button>
</div>

<dl class="card p-3">
    <table class="table table-bordered">
        <tbody>
            <tr>
                <th style="text-align: center; vertical-align: middle;">
                    <img src="@Model.collegeInfoModel.LogoURL" style="max-width: 400px " />
                </th>
                <td>
                    <h4>@Model.collegeInfoModel.CollegeName</h4>
                    @Model.collegeInfoModel.AddressLine1
                    <br />@Model.collegeInfoModel.AddressLine2
                    <br />@Model.collegeInfoModel.City - @Model.collegeInfoModel.Zip
                    <br />Contact: @Model.collegeInfoModel.ContactNo1
                </td>

                <td>
                    Admission Form No:
                    <br />@Model.studentInfoModel.AdmissionFormNo
                </td>
            </tr>
        </tbody>
    </table>
</dl>

<div class="row centered-header"><h2>Class @Model.studentInfoModel.ClassName Admission Form @WebConfigurationManager.AppSettings["CurrentAcademicYear"].ToString(): @Model.studentInfoModel.Stream</h2></div>

<dl class="card p-3">
    <table style="width: 100%; margin-top: 6px;">
        <tr>
            <td class="photo-cell">
                <div class="photo-label">Student</div>
                <img class="photo" src="@studentPhotoUrl" alt="Student Photo" /><br />
                <img class="signature" src="@studentSignatureUrl" alt="Student Signature" />
            </td>
            <td class="photo-cell">
                <div class="photo-label">Father</div>
                <img class="photo" src="@fatherPhotoUrl" alt="Father Photo" /><br />
                <img class="signature" src="@fatherSignatureUrl" alt="Father Signature" />
            </td>
            <td class="photo-cell">
                <div class="photo-label">Mother</div>
                <img class="photo" src="@motherPhotoUrl" alt="Mother Photo" /><br />
                <img class="signature" src="@motherSignatureUrl" alt="Mother Signature" />
            </td>
        </tr>
    </table>
</dl>

